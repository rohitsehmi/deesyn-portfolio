{
  "name": "revolut-case-studies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run tokens && astro build",
    "preview": "astro preview",
    "tokens": "node tokens/build.mjs && node tokens/css.mjs",
    "specs": "node design/build.mjs",
    "verify": "node tokens/verify.mjs && node design/verify.mjs && node design/verify-css.mjs",
    "verify:bands": "node design/verify-bands.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "astro": "^7.1.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "chromatic": "^18.1.0",
    "storybook": "^10.5.6",
    "typescript": "^7.0.2"
  }
}
