---
import Page from '../layouts/Page.astro';
import { ArrowLink } from '../components/Link';
import copy from '../copy/contact.json';

/**
 * Two links and a sentence. That is the whole page, on purpose.
 *
 * No form: one needs a backend, validation and a full state cycle to be worth
 * having, and a portfolio contact form converts worse than an address someone
 * can copy. No phone number either — it is on the CV PDF, which is handed to a
 * person, rather than on a URL a scraper can read.
 *
 * This is where the nav's one primary action lands, so it should not feel like
 * a page that ran out of content. It is short because it is finished.
 */
/*
  Labels come from the copy file so they are editable in the browser; the hrefs
  do not. An address you can retype in a live page is an address you can break
  in a live page, and the label is the part that is ever a writing decision.
*/
const links = [
  {
    key: 'email',
    label: copy.email,
    href: 'mailto:rohit.sehmi@gmail.com',
    /* Screen readers get what happens, since the glyph only says "away". */
    hint: 'Email Rohit Sehmi, opens your mail app'
  },
  {
    key: 'linkedin',
    label: copy.linkedin,
    href: 'https://www.linkedin.com/in/rohitsehmi',
    external: true,
    hint: 'LinkedIn profile, opens in a new tab'
  }
];
---
<Page
  title={copy.title}
  description="Get in touch with Rohit Sehmi — product and design systems designer, London."
  standfirst={copy.standfirst}
  standfirstCopyRef="contact:standfirst"
>
  {/*
    In the hero band, not below it. The links are what the standfirst is asking
    you to do, and a band seam between an invitation and the way to accept it
    put ~500px of empty page between them. Banding rule 1 — no two consecutive
    bands share a fill — names the fix as merging rather than restyling, and
    Page.astro already had the slot for it: "the one action a page is for, sat
    directly under the sentence that explains why you would want it."

    One wrapper div because `.page-hero__actions` is a flex row: passing the
    list and the note as two children would sit them side by side.
  */}
  <div slot="actions">
  <ul class="contact">
    {links.map((l) => (
      <li class="contact__item">
        {/*
          arrow-up-right on both. It means "this leaves the page", which is true
          of a mailto handing off to a mail client and of a profile opening in a
          new tab. An envelope on one and an arrow on the other would suggest
          the two behave differently, and they do not.
        */}
        <ArrowLink
          href={l.href}
          icon="arrow-up-right"
          aria-label={l.hint}
          copyRef={`contact:${l.key}`}
          {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {l.label}
        </ArrowLink>
      </li>
    ))}
  </ul>

  <p class="contact__where" data-copy="contact:where">{copy.where}</p>
  </div>
</Page>

<style is:global>
  .contact { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--primitive-layout-l40); }

  /*
    Larger than a body link. These are the page — at inline size they would sit
    in the middle of a mostly empty band looking like leftovers.
  */
  .contact__item .arrow-link {
    font: var(--type-heading-s);
    letter-spacing: var(--type-heading-s-tracking);
    /* Breaks the address rather than the layout on a narrow screen. */
    overflow-wrap: anywhere;
  }
  @media (min-width: 768px) {
    .contact__item .arrow-link {
      font: var(--type-heading-m);
      letter-spacing: var(--type-heading-m-tracking);
      overflow-wrap: normal;
    }
  }

  /*
    l40, not l64. In its own band the note was a separate block and needed the
    larger step; in the hero it is the tail of one group, and 64 against the
    40 between the links read as a detached orphan.
  */
  .contact__where {
    margin: var(--primitive-layout-l40) 0 0;
    font: var(--type-body-2);
    letter-spacing: var(--type-body-2-tracking);
    color: var(--semantic-fg-secondary);
  }
</style>