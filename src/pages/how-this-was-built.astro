---
import { readFileSync, readdirSync } from 'node:fs';
import Page from '../layouts/Page.astro';
import { Prose } from '../components/Prose';
import { SectionHeading } from '../components/SectionHeading';
import { Contribution } from '../components/Contribution';
import { ArrowLink } from '../components/Link';
import { SERVICE_MARKS } from '../components/service-marks';
import { hash } from '../../design/hash.mjs';
import c from '../copy/how-this-was-built.json';

/**
 * Every number on this page is computed here, at build time, from the files it
 * describes. Nothing is typed in. If the system shrinks, the page says so.
 *
 * That is the point: the case study argues for a specification machines can
 * read, and a page about it that had to be hand-updated would be arguing
 * against itself.
 *
 * The words live in src/copy/how-this-was-built.json like every other page.
 * The numbers cannot, so the copy carries {braced} placeholders and they are
 * substituted below — which keeps the whole sentence in one editable string
 * rather than splitting it around a value nobody is allowed to type.
 */
const tokens = JSON.parse(readFileSync('tokens/tokens.json', 'utf8'));
const banding = JSON.parse(readFileSync('design/banding-export.json', 'utf8'));

/**
 * How many checks run on a push, counted from the workflow that runs them.
 *
 * This was the word "Four", typed into the copy, on a page whose facts block
 * opens by saying none of its numbers were typed in. It had been wrong for a
 * while: Types, Secrets and the generated-files check were all missing from it
 * before Contracts was added on 2026-08-10, so the page was claiming four while
 * CI ran eight.
 *
 * Scoped to the `verify` job rather than counting `- name:` across the file.
 * The chromatic job has no named steps today, so a whole-file count would give
 * the right answer now and the wrong one the moment anyone named one.
 */
const workflow = readFileSync('.github/workflows/ci.yml', 'utf8');
const verifyJob = workflow.slice(
  workflow.indexOf('\n  verify:'),
  workflow.indexOf('\n  chromatic:')
);
const checkCount = (verifyJob.match(/^\s+- name:/gm) ?? []).length;
if (!checkCount) throw new Error('could not count check steps in .github/workflows/ci.yml');

const leaves = (node: any): number =>
  Object.entries(node).reduce((n, [k, v]: [string, any]) => {
    if (k.startsWith('$')) return n;
    if (v && v.$value !== undefined) return n + 1;
    return v && typeof v === 'object' ? n + leaves(v) : n;
  }, 0);

const specDirs = ['components/specs', 'icons/specs', 'marks/specs'];
const specSlugs = new Set(
  specDirs.flatMap((d) => readdirSync(d).filter((f) => f.endsWith('.json')).map((f) => f.slice(0, -5)))
);

const componentFiles = readdirSync('src/components')
  .filter((f) => f.endsWith('.tsx') && !f.endsWith('.stories.tsx'));
const componentCount = componentFiles.length;

/**
 * How many components actually have a published contract, checked one by one.
 *
 * This used to be `specSlugs.size`, and it read as 1:1 coverage while being a
 * coincidence. Two errors cancelled exactly: `Link.tsx` exports both Link and
 * ArrowLink and so produces *two* specs, while `Band.tsx` produces *none* in
 * these directories, because a band is a page-layout primitive and its contract
 * lives in design/banding-export.json with the adjacency rules it belongs to.
 *
 * Counting files gave the right number for the wrong reason, and would have
 * started making a false claim on a public page the moment anyone added a
 * component. This asks the real question instead: for each component, is there
 * a contract somewhere that describes it? `npm run verify` fails if the answer
 * is ever no, so the sentence below cannot quietly stop being true.
 */
const CONTRACT_ELSEWHERE: Record<string, string> = {
  // slug -> the file that publishes its contract instead
  band: 'design/banding-export.json'
};
const SPEC_DOMAINS = ['action', 'content', 'layout', 'chrome', 'brand'];
const slugFor = (file: string) =>
  file.slice(0, -4).replace(/(?<!^)(?=[A-Z])/g, '-').toLowerCase();
const hasContract = (file: string) => {
  const slug = slugFor(file);
  if (slug in CONTRACT_ELSEWHERE) return true;
  return [...specSlugs].some((s) => s === slug || SPEC_DOMAINS.some((d) => s === `${d}-${slug}`));
};
const specCount = componentFiles.filter(hasContract).length;

const storyCount = readdirSync('src/components')
  .filter((f) => f.endsWith('.stories.tsx'))
  .reduce((n, f) => n + (readFileSync(`src/components/${f}`, 'utf8').match(/export const /g)?.length ?? 0), 0);

/** Recomputed here rather than quoted, using the same hash the verifiers use. */
const canonical = (v: any): string => {
  if (Array.isArray(v)) return `[${v.map(canonical).join(',')}]`;
  if (v && typeof v === 'object') {
    return `{${Object.keys(v).filter((k) => !k.startsWith('_')).sort()
      .map((k) => `${k}:${canonical(v[k])}`).join(',')}}`;
  }
  return JSON.stringify(v);
};

/**
 * The substitutions the copy is allowed to name. A placeholder with no entry
 * here is left in the string rather than blanked, so a typo shows up as
 * `{primitves}` on the page instead of as a plausible-looking gap.
 */
const numbers: Record<string, string | number> = {
  primitives: leaves(tokens.primitive),
  semantic: leaves(tokens.semantic.light),
  textStyles: leaves(tokens.typography),
  components: componentCount,
  specs: specCount,
  checks: checkCount,
  stories: storyCount,
  rules: banding.rules.length,
  checksum: hash(canonical(banding))
};

const fill = (s: string) =>
  s.replace(/\{(\w+)\}/g, (whole, key) => (key in numbers ? String(numbers[key]) : whole));

const facts = c.facts.items.map((f) => ({ term: f.term, detail: fill(f.detail) }));
---

<Page
  title={c.title}
  standfirst={c.standfirst}
  titleCopyRef="how-this-was-built:title"
  standfirstCopyRef="how-this-was-built:standfirst"
  readingTimeFor="how-this-was-built"
>
  {/* The lead is an hb-block like everything else on this page. Left outside,
      it sat at zero against the facts table below it: `.hb-block + .hb-block`
      only spaces a block against another block, and the lead was neither. */}
  <div class="hb-block">
    <Prose lead>
      {c.lead.map((p, i) => <p data-copy={`how-this-was-built:lead.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="hb-block">
    <SectionHeading level={2} size={3} copyRef="how-this-was-built:workflow.heading">
      {c.workflow.heading}
    </SectionHeading>
    <Contribution items={c.workflow.items} copyBase="how-this-was-built:workflow.items" />
  </div>

  <div class="hb-block">
    <SectionHeading level={2} size={3} copyRef="how-this-was-built:facts.heading">
      {c.facts.heading}
    </SectionHeading>
    <Prose>
      <p data-copy="how-this-was-built:facts.intro">{c.facts.intro}</p>
    </Prose>
    {/* Not editable in place: the rendered string has had its numbers
        substituted, so writing it back would bake today's counts into the copy
        and the page would stop recomputing. Edit it in the JSON. */}
    <Contribution items={facts} />
  </div>

  <div class="hb-block">
    <SectionHeading level={2} size={3} copyRef="how-this-was-built:checks.heading">
      {c.checks.heading}
    </SectionHeading>
    <Prose>
      <p data-copy="how-this-was-built:checks.intro">{c.checks.intro}</p>
      <ul>
        {c.checks.items.map((item, i) => (
          <li>
            <strong data-copy={`how-this-was-built:checks.items.${i}.label`}>{item.label}</strong>
            {' '}
            <span data-copy={`how-this-was-built:checks.items.${i}.text`}>{item.text}</span>
            {item.code && (
              <>
                {' '}
                <code data-copy={`how-this-was-built:checks.items.${i}.code`}>{item.code}</code>
                {' '}
                <span data-copy={`how-this-was-built:checks.items.${i}.textAfter`}>{item.textAfter}</span>
              </>
            )}
          </li>
        ))}
      </ul>
    </Prose>
  </div>

  <div class="hb-block">
    <SectionHeading level={2} size={3} copyRef="how-this-was-built:limits.heading">
      {c.limits.heading}
    </SectionHeading>
    <Prose>
      {c.limits.paras.map((p, i) => <p data-copy={`how-this-was-built:limits.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="hb-block">
    <SectionHeading level={2} size={3} copyRef="how-this-was-built:links.heading">
      {c.links.heading}
    </SectionHeading>
    {/*
      arrow-up-right, not arrow-thin-right: these leave the site, and the
      diagonal is the convention for that. It is the reason the icon exists in
      the set — Revolut ships no diagonal, so it is their thin arrow rotated.
    */}
    <ul class="hb-links">
      {c.links.items.map((l, i) => {
        const mark = SERVICE_MARKS[l.mark];
        return (
          <li class="hb-links__item">
            {/*
              aria-hidden, because the link beside it already says which
              service this is. A mark that repeats the link's own name is
              decoration to a screen reader, not information.
            */}
            <svg class="hb-links__mark" viewBox={mark.viewBox} aria-hidden="true" focusable="false">
              {mark.paths.map((d) => <path d={d} />)}
            </svg>
            <ArrowLink
              href={l.href}
              icon="arrow-up-right"
              data-receipt={l.mark}
              copyRef={`how-this-was-built:links.items.${i}.label`}
            >
              {l.label}
            </ArrowLink>
            <p class="hb-links__note" data-copy={`how-this-was-built:links.items.${i}.note`}>{l.note}</p>
          </li>
        );
      })}
    </ul>
  </div>
</Page>

<style is:global>
  .hb-block + .hb-block { margin-block-start: var(--primitive-layout-l64); }

  /*
    The same three-step rhythm the case-study sections use, for the same reason:
    only SectionHeading owns the space after it, so without this a heading's
    content and the block below it both stack at zero. Class doubled to outrank
    a component resetting its own root margin; the heading override stops the
    40px collapsing into the 64px. See CLAUDE.md § Case studies.
  */
  .hb-block.hb-block > * + * { margin-block-start: var(--primitive-layout-l64); }
  .hb-block.hb-block > .section-heading + * { margin-block-start: 0; }

  .hb-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--primitive-layout-l40);
  }
  @media (min-width: 768px) {
    .hb-links { grid-template-columns: repeat(3, 1fr); }
  }
  /* The link owns the space to its own note, so the grid gap stays one value. */
  .hb-links__item > * + * { margin-block-start: var(--primitive-space-sp300); }
  /*
    currentColor, so each mark takes the foreground of the band it lands in and
    reads in both themes. Brand colours were the alternative and are wrong here:
    three saturated logos fight each other, and GitHub's near-black disappears
    entirely against an inverse band.
  */
  .hb-links__mark {
    display: block;
    width: var(--primitive-size-s24);
    height: var(--primitive-size-s24);
    fill: currentColor;
    color: var(--semantic-fg-secondary);
  }
  .hb-links__note {
    margin: 0;
    font: var(--type-body-2);
    letter-spacing: var(--type-body-2-tracking);
    color: var(--semantic-fg-secondary);
  }
</style>

<script>
  import { trackReceipts } from '../components/analytics';
  trackReceipts();
</script>
