---
import CaseStudy from '../../layouts/CaseStudy.astro';
import { SectionHeading } from '../../components/SectionHeading';
import { Prose } from '../../components/Prose';
import { Metrics } from '../../components/Metrics';
import { Explorations } from '../../components/Explorations';
import { Hindsight } from '../../components/Hindsight';
import { Contribution } from '../../components/Contribution';
import { TokenTiers } from '../../components/TokenTiers';
import {
  GOVERNANCE_REJECTED, GOVERNANCE_STAGES, GOVERNANCE_TIERS
} from '../../data/egds-governance-tiers';
import {
  BASE_COMPONENT, BRANDS, BRAND_PICKER_LEGEND, BRAND_ROW_LABELS, DEPICTED_ACCENT,
  SHARED_SEMANTIC, TIERS, TIER_NOTE
} from '../../data/egds-token-tiers';
import {
  COMPONENT_DECISIONS, COMPONENT_MODELS, COMPONENT_MODELS_BASE,
  COMPONENT_MODELS_CHANGE, COMPONENT_MODELS_SUBJECT, DESIGN_LANGUAGES
} from '../../data/egds-component-models';
import {
  CONVERGENCE_NOTES, CONVERGENCE_SCENARIOS, CONVERGENCE_TRADE
} from '../../data/egds-convergence-scenarios';
import copy from '../../copy/scaling-a-system.json';

/**
 * LIVE since 2026-08-17, on the Wise and Healf hosts only — see `brands` in
 * src/data/studies.ts. It carries zero [NEEDS: …] markers and must keep it:
 * verify-gaps is a CI step and fails the build on a marker that would render
 * on a live page, which is what makes "finished" a property the build checks
 * rather than something somebody has to remember.
 *
 * PROVENANCE, and it is the reason this study was archived for twelve days.
 * Every project-level fact here is taken from two colleagues' published
 * accounts of the same programme — heeranmaster.com/home/scaling-a-system and
 * madebyjoe.uk/work/egds — and nothing has been invented or rounded up. What
 * neither page can supply is Rohit's own contribution, since each describes
 * its author's, so everything about what he personally decided comes from his
 * CV instead. The previous draft carried Heeran's job title as the Role, which
 * is exactly the failure that separation exists to prevent.
 *
 * Tooling, the typeahead component and the workshops are deliberately absent.
 * Those are the parts of Joe's account that were his own work rather than the
 * programme's, and they are not ours to retell.
 */
const F = 'scaling-a-system';
const { contribution, problem, process, interface: iface, impact, hindsight } = copy;

/*
  Which exploration each diagram belongs to, resolved from the copy rather than
  hardcoded to a position. Reordering the list would otherwise drop a diagram
  back to an "Image needed" placeholder without failing anything, which is the
  class of bug this file's own history is full of. So it throws.
*/
const explorationAt = (opening: string) => {
  const i = process.explorations.findIndex((e) => e.title.startsWith(opening));
  if (i === -1) {
    throw new Error(
      `scaling-a-system: no exploration titled "${opening}…" for its diagram. ` +
      'If the title changed, update the match here rather than deleting it.'
    );
  }
  return i;
};

const MODELS = explorationAt('Building all four');
const CONVERGENCE = explorationAt('The middle convergence');
const GOVERNANCE = explorationAt('Letting any team');

/*
  THE FIGURE IS BUILT, NOT EXPORTED, changed 2026-08-19.

  It shipped first as src/assets/egds-token-tiers-light.png, and the note that
  used to sit here said the dark counterpart was outstanding rather than
  declined: the artwork carries the theme in its own fills and sits on a
  near-white plate, so on a dark page it was a lit panel in the middle of an
  article. That is the case MediaProps.srcDark exists for, and the second export
  never landed.

  Drawing it in elements retires the question instead of answering it. The
  chrome resolves from the page's own tokens, so it is right in both themes at
  every width, it repaints with the brand pack, and there is nothing to
  download. What the picture DEPICTS stays fixed, in src/data/egds-token-tiers.ts
  and sampled pixel by pixel from the PNG, because a diagram of another system's
  palette that repaints with yours has stopped being true.

  The PNG is kept rather than deleted. It is the thing this was measured from,
  and design/asset-provenance.json still carries its entry and its history.
*/
---

<CaseStudy
  title={copy.title}
  slug="scaling-a-system"
  standfirst={copy.standfirst}
  titleCopyRef={`${F}:title`}
  standfirstCopyRef={`${F}:standfirst`}
>
  <Contribution slot="contribution" items={contribution} copyBase={`${F}:contribution`} />

  <div class="cs-section" slot="problem">
    <SectionHeading
      standfirst={problem.standfirst}
      copyRef={`${F}:problem.heading`}
      standfirstCopyRef={`${F}:problem.standfirst`}
    >
      {problem.heading}
    </SectionHeading>
    <Prose lead>
      {problem.paras.map((p, i) => <p data-copy={`${F}:problem.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="process">
    <SectionHeading
      standfirst={process.standfirst}
      copyRef={`${F}:process.heading`}
      standfirstCopyRef={`${F}:process.standfirst`}
    >
      {process.heading}
    </SectionHeading>
    <Prose>
      {process.paras.map((p, i) => <p data-copy={`${F}:process.paras.${i}`}>{p}</p>)}
    </Prose>

    <SectionHeading level={3} copyRef={`${F}:process.explorationsHeading`}>
      {process.explorationsHeading}
    </SectionHeading>
    <Prose>
      <p data-copy={`${F}:process.explorationsIntro`}>{process.explorationsIntro}</p>
    </Prose>
    {/*
      `stack`, not the default grid. Explorations.tsx says why in as many words:
      a wide comparison is illegible at half measure, and all three artefacts
      here are wide. The governance diagram is three panels side by side and the
      component-models one is two structures side by side; both need the whole
      column, and the convergence scale runs the full measure of the article.
    */}
    <Explorations
      layout="stack"
      items={process.explorations.map((e, i) => ({
        title: e.title,
        why: e.why,
        ...(i === MODELS
          ? {
              diagram: {
                kind: 'component-models' as const,
                alt: e.imageAlt,
                subject: COMPONENT_MODELS_SUBJECT,
                languages: DESIGN_LANGUAGES,
                decisions: COMPONENT_DECISIONS,
                models: COMPONENT_MODELS,
                base: COMPONENT_MODELS_BASE,
                change: COMPONENT_MODELS_CHANGE
              }
            }
          : i === CONVERGENCE
          ? {
              diagram: {
                kind: 'convergence' as const,
                alt: e.imageAlt,
                scenarios: CONVERGENCE_SCENARIOS,
                trade: CONVERGENCE_TRADE,
                notes: CONVERGENCE_NOTES
              }
            }
          : i === GOVERNANCE
          ? {
              diagram: {
                kind: 'governance' as const,
                alt: e.imageAlt,
                stages: GOVERNANCE_STAGES,
                tiers: GOVERNANCE_TIERS,
                rejected: GOVERNANCE_REJECTED
              }
            }
          : { image: { alt: e.imageAlt } })
      }))}
      copyBase={`${F}:process.explorations`}
    />
  </div>

  <div class="cs-section" slot="interface">
    <SectionHeading
      standfirst={iface.standfirst}
      copyRef={`${F}:interface.heading`}
      standfirstCopyRef={`${F}:interface.standfirst`}
    >
      {iface.heading}
    </SectionHeading>
    <TokenTiers
      alt={iface.mediaAlt}
      base={BASE_COMPONENT}
      tiers={TIERS}
      note={TIER_NOTE}
      brands={BRANDS}
      sharedSemantic={SHARED_SEMANTIC}
      rowLabels={BRAND_ROW_LABELS}
      pickerLegend={BRAND_PICKER_LEGEND}
      tint={DEPICTED_ACCENT}
      caption={iface.mediaCaption}
      captionCopyRef={`${F}:interface.mediaCaption`}
    />
    <Prose>
      {iface.paras.map((p, i) => <p data-copy={`${F}:interface.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="impact">
    <SectionHeading
      standfirst={impact.standfirst}
      copyRef={`${F}:impact.heading`}
      standfirstCopyRef={`${F}:impact.standfirst`}
    >
      {impact.heading}
    </SectionHeading>
    <Metrics
      items={impact.metrics}
      source={impact.metricsSource}
      copyBase={`${F}:impact.metrics`}
      sourceCopyRef={`${F}:impact.metricsSource`}
    />
    <Prose>
      {impact.paras.map((p, i) => <p data-copy={`${F}:impact.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="hindsight">
    <Hindsight>
      {hindsight.paras.map((p, i) => <p data-copy={`${F}:hindsight.paras.${i}`}>{p}</p>)}
    </Hindsight>
  </div>
</CaseStudy>