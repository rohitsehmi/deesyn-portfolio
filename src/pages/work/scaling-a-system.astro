---
import CaseStudy from '../../layouts/CaseStudy.astro';
import { SectionHeading } from '../../components/SectionHeading';
import { Prose } from '../../components/Prose';
import { Metrics } from '../../components/Metrics';
import { Explorations } from '../../components/Explorations';
import { Hindsight } from '../../components/Hindsight';
import { Contribution } from '../../components/Contribution';
import { Media } from '../../components/Media';
import { getImage } from 'astro:assets';
import imgTokenTiers from '../../assets/egds-token-tiers-light.png';
import copy from '../../copy/scaling-a-system.json';

/**
 * LIVE since 2026-08-17, on the Wise and Healf hosts only — see `brands` in
 * src/data/studies.ts. It carries zero [NEEDS: …] markers and must keep it:
 * verify-gaps is a CI step and fails the build on a marker that would render
 * on a live page, which is what makes "finished" a property the build checks
 * rather than something somebody has to remember.
 *
 * PROVENANCE, and it is the reason this study was archived for twelve days.
 * Every project-level fact here is taken from two colleagues' published
 * accounts of the same programme — heeranmaster.com/home/scaling-a-system and
 * madebyjoe.uk/work/egds — and nothing has been invented or rounded up. What
 * neither page can supply is Rohit's own contribution, since each describes
 * its author's, so everything about what he personally decided comes from his
 * CV instead. The previous draft carried Heeran's job title as the Role, which
 * is exactly the failure that separation exists to prevent.
 *
 * Tooling, the typeahead component and the workshops are deliberately absent.
 * Those are the parts of Joe's account that were his own work rather than the
 * programme's, and they are not ours to retell.
 */
const F = 'scaling-a-system';
const { contribution, problem, process, interface: iface, impact, hindsight } = copy;

/*
  Same pipeline as the other studies: WebP at each width, original pruned.

  `natural`, never a cropping ratio. This is a diagram, so its title sits along
  the top and its per-brand labels along the bottom, and those are precisely
  the pixels `object-fit: cover` removes — see MediaProps.ratio.

  NO srcDark YET. The artwork carries the theme in its own fills and sits on a
  near-white plate, so on a dark page it currently reads as a bright panel mid
  article. That is the case MediaProps.srcDark exists for and the dark export
  is outstanding, not declined; wire it here the moment it lands.
*/
const FIGURE_SIZES = '(min-width: 1040px) 1000px, calc(100vw - 40px)';
const tokenTiers = await getImage({
  src: imgTokenTiers,
  format: 'webp',
  widths: [480, 720, 960, 1280, 1600],
  sizes: FIGURE_SIZES
});
---

<CaseStudy
  title={copy.title}
  slug="scaling-a-system"
  standfirst={copy.standfirst}
  titleCopyRef={`${F}:title`}
  standfirstCopyRef={`${F}:standfirst`}
>
  <Contribution slot="contribution" items={contribution} copyBase={`${F}:contribution`} />

  <div class="cs-section" slot="problem">
    <SectionHeading
      standfirst={problem.standfirst}
      copyRef={`${F}:problem.heading`}
      standfirstCopyRef={`${F}:problem.standfirst`}
    >
      {problem.heading}
    </SectionHeading>
    <Prose lead>
      {problem.paras.map((p, i) => <p data-copy={`${F}:problem.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="process">
    <SectionHeading
      standfirst={process.standfirst}
      copyRef={`${F}:process.heading`}
      standfirstCopyRef={`${F}:process.standfirst`}
    >
      {process.heading}
    </SectionHeading>
    <Prose>
      {process.paras.map((p, i) => <p data-copy={`${F}:process.paras.${i}`}>{p}</p>)}
    </Prose>

    <SectionHeading level={3} copyRef={`${F}:process.explorationsHeading`}>
      {process.explorationsHeading}
    </SectionHeading>
    <Prose>
      <p data-copy={`${F}:process.explorationsIntro`}>{process.explorationsIntro}</p>
    </Prose>
    <Explorations
      items={process.explorations.map((e) => ({
        title: e.title,
        why: e.why,
        image: { alt: e.imageAlt }
      }))}
      copyBase={`${F}:process.explorations`}
    />
  </div>

  <div class="cs-section" slot="interface">
    <SectionHeading
      standfirst={iface.standfirst}
      copyRef={`${F}:interface.heading`}
      standfirstCopyRef={`${F}:interface.standfirst`}
    >
      {iface.heading}
    </SectionHeading>
    <Media
      src={tokenTiers.src}
      srcSet={tokenTiers.srcSet.attribute}
      sizes={FIGURE_SIZES}
      alt={iface.mediaAlt}
      ratio="natural"
      caption={iface.mediaCaption}
      captionCopyRef={`${F}:interface.mediaCaption`}
    />
    <Prose>
      {iface.paras.map((p, i) => <p data-copy={`${F}:interface.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="impact">
    <SectionHeading
      standfirst={impact.standfirst}
      copyRef={`${F}:impact.heading`}
      standfirstCopyRef={`${F}:impact.standfirst`}
    >
      {impact.heading}
    </SectionHeading>
    <Metrics
      items={impact.metrics}
      source={impact.metricsSource}
      copyBase={`${F}:impact.metrics`}
      sourceCopyRef={`${F}:impact.metricsSource`}
    />
    <Prose>
      {impact.paras.map((p, i) => <p data-copy={`${F}:impact.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="hindsight">
    <Hindsight>
      {hindsight.paras.map((p, i) => <p data-copy={`${F}:hindsight.paras.${i}`}>{p}</p>)}
    </Hindsight>
  </div>
</CaseStudy>