---
import CaseStudy from '../../layouts/CaseStudy.astro';
import { SectionHeading } from '../../components/SectionHeading';
import { Prose } from '../../components/Prose';
import { Metrics } from '../../components/Metrics';
import { Explorations } from '../../components/Explorations';
import { Hindsight } from '../../components/Hindsight';
import { Contribution } from '../../components/Contribution';
import { Media } from '../../components/Media';
import { Carousel } from '../../components/Carousel';
import c from '../../copy/making-the-app-testable.json';
import { getImage } from 'astro:assets';
/*
  All three exploration graphics carry the theme in their own fills — the plate
  behind the phones is part of the artwork, not part of the picture — so each
  ships as a light/dark pair. That is still the exception rather than the rule:
  see MediaProps.srcDark for why a single absolute image is the default, and
  note the pair can cost the reader two downloads.

  The gallery pair landed 2026-08-13; recap and sign-in followed the same day.
*/
import imgGallery from '../../assets/hcom-exploration-gallery-light.png';
import imgGalleryDark from '../../assets/hcom-exploration-gallery-dark.png';
/*
  The gallery's plate, exported once per theme from the `Backdrop` frame rather
  than baked into each slide. One element behind a transparent track cannot
  twitch as the slides advance, and it holds its box across a theme change
  because only the fill swaps.
*/
import imgBackdrop from '../../assets/hcom-backdrop-light.png';
import imgBackdropDark from '../../assets/hcom-backdrop-dark.png';
/*
  The gallery slides: the phones alone, on transparency, so the one backdrop
  behind them is what the reader sees change theme.

  There is deliberately no light/dark pair here. Figma holds each composition as
  two frames, but the `Screens` group inside them is the same captures, and the
  two exports came out byte-identical — same SHA-256 for all three. A phone
  screenshot has no theme; only the plate it sits on does. Shipping both would
  be 6MB of duplicate.

  ON THE `-light` SUFFIX, which these carry without having a `-dark` sibling.
  It names the Figma frame the file came out of, not a promise that a pair
  exists. The whole export set is suffixed that way, so a filename here is the
  filename in the export folder and a new drop is a copy rather than a copy and
  a rename — which is the step that goes wrong. Whether a pair exists is
  answered by explorationShotsDark below, in code, where it can be checked.
*/
import imgHome1 from '../../assets/hcom-home-01-search-card-light.png';
import imgHome2 from '../../assets/hcom-home-02-recent-searches-light.png';
import imgHome3 from '../../assets/hcom-home-03-contextual-light.png';
/*
  Results, five screens: the layout that existed, the three adaptive layouts
  built to be tested against each other, and the generation that followed.

  The middle three are the comparison the prose is about, and they are only
  legible as one because everything except the card is held constant — same
  header, same filter chips, same three properties at the same prices. The
  first and last deliberately do NOT match that chrome, which is what makes
  them read as different generations rather than as two more variants.

  Export them the way the home screens are exported, selecting `Screens` rather
  than the whole frame, so the shared backdrop shows through instead of each
  slide carrying its own baked-in plate.
*/
import imgResults1 from '../../assets/hcom-results-01-compact-list-light.png';
import imgResults2 from '../../assets/hcom-results-02-filters-thumbnail-light.png';
import imgResults3 from '../../assets/hcom-results-03-image-left-light.png';
import imgResults4 from '../../assets/hcom-results-04-full-bleed-light.png';
import imgResults5 from '../../assets/hcom-results-05-destination-hero-light.png';
import imgRecap from '../../assets/hcom-exploration-recap-light.png';
import imgRecapDark from '../../assets/hcom-exploration-recap-dark.png';
import imgSignIn from '../../assets/hcom-exploration-signin-light.png';
import imgSignInDark from '../../assets/hcom-exploration-signin-dark.png';

/**
 * DRAFT. Study two of two: the Product Design discipline.
 *
 * Every word lives in src/copy/making-the-app-testable.json, in reading order, so the
 * whole voice can be read in one file and edited in the browser while
 * `npm run dev` runs. This file is the arrangement; that file is the writing.
 *
 * Drafted from rohitsehmi.com/apps, which covers five separate initiatives on
 * one page. This takes three of them — A Contextual Home, Search Experience,
 * and the Small Enhancements testing programme — because they are one argument
 * rather than three projects: two structural rebuilds that made testing
 * possible, and the programme that then ran through them. Both rebuilds say so
 * in their own stated rationale on that page.
 *
 * Started as `contextual-home` on 2026-08-06 and was renamed the same day. That
 * version had the metrics and little else it needed — in particular
 * an empty explorations section, because the source records only what shipped.
 * Bringing the testing programme in fills it with three real tests, one of them
 * a loser kept and retested, and it makes the "hypothesis to learn, not to
 * predict" principle this study's own rather than a borrowed line.
 *
 * The risk this shape carries is being a survey — three initiatives stapled
 * together, which is why scaling-a-system was archived. It is held off by
 * having one thesis and using the three only as evidence for it. If a section
 * ever starts to read as "and then I also did X", that has failed.
 *
 * The arrangement deliberately mirrors the other studies: same slots in the
 * same order, so the portfolio reads as one thing rather than as
 * separate attempts.
 */
const F = 'making-the-app-testable';

/* Same pipeline and the same reasoning as the other study: WebP at each width,
   originals pruned, and `natural` because every one of these carries a title
   and a table of figures that a cover crop would cut off. */
const EXPLORATION_SIZES = '(min-width: 1040px) 1000px, calc(100vw - 40px)';
const FIGURE_SIZES = '(min-width: 1040px) 1000px, calc(100vw - 40px)';
const shot = (src: ImageMetadata, sizes: string) =>
  getImage({ src, format: 'webp', widths: [480, 720, 960, 1280, 1600], sizes });

const [exGallery, exRecap, exSignIn] = await Promise.all([
  shot(imgGallery, EXPLORATION_SIZES),
  shot(imgRecap, EXPLORATION_SIZES),
  shot(imgSignIn, EXPLORATION_SIZES)
]);

/* Index-aligned with copy.process.explorations. */
const explorationShots = [exGallery, exRecap, exSignIn];

/*
  Index-aligned with explorationShots. All three have a dark counterpart now,
  but the array keeps its `undefined` slots meaningful rather than collapsing
  to a plain map: a fourth exploration added as a single absolute image is the
  normal case, and `undefined` there means "does not change with the theme"
  rather than "dark version still to come".
*/
const [exGalleryDark, exRecapDark, exSignInDark] = await Promise.all([
  shot(imgGalleryDark, EXPLORATION_SIZES),
  shot(imgRecapDark, EXPLORATION_SIZES),
  shot(imgSignInDark, EXPLORATION_SIZES)
]);
const explorationShotsDark = [exGalleryDark, exRecapDark, exSignInDark];

/* The interface section's gallery, index-aligned with copy.interface.slides. */
const homeSlides = await Promise.all([
  shot(imgHome1, FIGURE_SIZES),
  shot(imgHome2, FIGURE_SIZES),
  shot(imgHome3, FIGURE_SIZES)
]);
const resultsSlides = await Promise.all([
  shot(imgResults1, FIGURE_SIZES),
  shot(imgResults2, FIGURE_SIZES),
  shot(imgResults3, FIGURE_SIZES),
  shot(imgResults4, FIGURE_SIZES),
  shot(imgResults5, FIGURE_SIZES)
]);
const [bgLight, bgDark] = await Promise.all([
  shot(imgBackdrop, EXPLORATION_SIZES),
  shot(imgBackdropDark, EXPLORATION_SIZES)
]);
---

<CaseStudy
  title={c.title}
  slug="making-the-app-testable"
  standfirst={c.standfirst}
  titleCopyRef={`${F}:title`}
  standfirstCopyRef={`${F}:standfirst`}
>
  <Contribution slot="contribution" items={c.contribution} copyBase={`${F}:contribution`} />

  <div class="cs-section" slot="problem">
    <SectionHeading
      standfirst={c.problem.standfirst}
      copyRef={`${F}:problem.heading`}
      standfirstCopyRef={`${F}:problem.standfirst`}
    >
      {c.problem.heading}
    </SectionHeading>
    <Prose lead>
      {c.problem.paras.map((p, i) => <p data-copy={`${F}:problem.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="process">
    <SectionHeading
      standfirst={c.process.standfirst}
      copyRef={`${F}:process.heading`}
      standfirstCopyRef={`${F}:process.standfirst`}
    >
      {c.process.heading}
    </SectionHeading>
    <Prose>
      <p data-copy={`${F}:process.openingPara`}>{c.process.openingPara}</p>
      {/*
        Three spans rather than one string, because the middle is emphasised and
        editing is plain text: a <strong> inside a single editable string would
        be stripped the first time anyone touched it.
      */}
      <p>
        <span data-copy={`${F}:process.principle.before`}>{c.process.principle.before}</span>
        <strong data-copy={`${F}:process.principle.quote`}>{c.process.principle.quote}</strong>
        <span data-copy={`${F}:process.principle.after`}>{c.process.principle.after}</span>
      </p>
      <p data-copy={`${F}:process.closingPara`}>{c.process.closingPara}</p>
    </Prose>

    <SectionHeading level={3} copyRef={`${F}:process.explorationsHeading`}>
      {c.process.explorationsHeading}
    </SectionHeading>
    <Explorations
      layout="stack"
      copyBase={`${F}:process.explorations`}
      items={c.process.explorations.map((e, i) => ({
        title: e.title,
        why: e.why,
        image: {
          src: explorationShots[i].src,
          srcSet: explorationShots[i].srcSet.attribute,
          ...(explorationShotsDark[i]
            ? { srcDark: explorationShotsDark[i]!.src, srcSetDark: explorationShotsDark[i]!.srcSet.attribute }
            : {}),
          sizes: EXPLORATION_SIZES,
          alt: e.imageAlt,
          ratio: 'natural' as const
        }
      }))}
    />
  </div>

  <div class="cs-section" slot="interface">
    <SectionHeading
      standfirst={c.interface.standfirst}
      copyRef={`${F}:interface.heading`}
      standfirstCopyRef={`${F}:interface.standfirst`}
    >
      {c.interface.heading}
    </SectionHeading>
    {/*
      The three generations, one at a time, replacing the flat composite that
      held this slot until 2026-08-13. Three homes lined up at a third of the
      width each are three pictures nobody can read; the argument this section
      makes is about how one screen changed, which is a sequence rather than a
      row.

      The second block, the three adaptive results layouts, sits below the
      paragraph about the home and above the one about results, so each gallery
      is next to the prose that argues for it rather than both stacking at the
      top. It held nothing until 2026-08-13, when the captures arrived.
    */}
    <Carousel
      label={c.interface.heading}
      sizes={FIGURE_SIZES}
      /* 5s. Three was not long enough to read a phone screen, which is the
         only thing on the slide. */
      autoplayMs={5000}
      backdrop={{
        src: bgLight.src,
        srcSet: bgLight.srcSet.attribute,
        srcDark: bgDark.src,
        srcSetDark: bgDark.srcSet.attribute
      }}
      slides={homeSlides.map((s, n) => ({
        src: s.src,
        srcSet: s.srcSet.attribute,
        alt: c.interface.slides[n].alt,
        label: c.interface.slides[n].label
      }))}
      caption={c.interface.mediaCaption}
      captionCopyRef={`${F}:interface.mediaCaption`}
    />
    {/*
      Split rather than mapped, because a gallery now sits between the two
      paragraphs. Each paragraph is its own Prose block, which is also the
      correct rhythm: two peers 64px apart with the figure between them, rather
      than the 20px that `.prose > * + *` gives paragraphs inside one block.
    */}
    <Prose>
      <p data-copy={`${F}:interface.paras.0`}>{c.interface.paras[0]}</p>
    </Prose>

    <Carousel
      label={c.interface.resultsLabel}
      sizes={FIGURE_SIZES}
      /* Same 5s as the home gallery, per slide rather than per cycle: the
         dwell has to be long enough to read one phone screen, and that does
         not change because there are five of them. */
      autoplayMs={5000}
      backdrop={{
        src: bgLight.src,
        srcSet: bgLight.srcSet.attribute,
        srcDark: bgDark.src,
        srcSetDark: bgDark.srcSet.attribute
      }}
      slides={resultsSlides.map((s, n) => ({
        src: s.src,
        srcSet: s.srcSet.attribute,
        alt: c.interface.resultsSlides[n].alt,
        label: c.interface.resultsSlides[n].label
      }))}
      caption={c.interface.resultsCaption}
      captionCopyRef={`${F}:interface.resultsCaption`}
    />

    <Prose>
      <p data-copy={`${F}:interface.paras.1`}>{c.interface.paras[1]}</p>
    </Prose>
  </div>

  <div class="cs-section" slot="impact">
    <SectionHeading
      standfirst={c.impact.standfirst}
      copyRef={`${F}:impact.heading`}
      standfirstCopyRef={`${F}:impact.standfirst`}
    >
      {c.impact.heading}
    </SectionHeading>
    <Metrics
      items={c.impact.metrics}
      source={c.impact.metricsSource}
      copyBase={`${F}:impact.metrics`}
      sourceCopyRef={`${F}:impact.metricsSource`}
    />
    <Prose>
      {c.impact.paras.map((p, i) => <p data-copy={`${F}:impact.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="hindsight">
    <Hindsight>
      {c.hindsight.paras.map((p, i) => <p data-copy={`${F}:hindsight.paras.${i}`}>{p}</p>)}
    </Hindsight>
  </div>
</CaseStudy>