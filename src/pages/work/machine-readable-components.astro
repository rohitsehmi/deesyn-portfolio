---
import CaseStudy from '../../layouts/CaseStudy.astro';
import { SectionHeading } from '../../components/SectionHeading';
import { Prose } from '../../components/Prose';
import { Metrics } from '../../components/Metrics';
import { Explorations } from '../../components/Explorations';
import { Hindsight } from '../../components/Hindsight';
import { Contribution } from '../../components/Contribution';
import { Media } from '../../components/Media';
import c from '../../copy/machine-readable-components.json';
import { getImage } from 'astro:assets';
import imgVerticalOffset from '../../assets/nca-exploration-vertical-offset.png';
import imgDarkFrame from '../../assets/nca-exploration-dark-frame.png';
import imgMaxHeight from '../../assets/nca-exploration-max-height.png';
import imgDialog from '../../assets/nca-dialog-platforms.png';

/**
 * DRAFT. Study one of two: the Design Systems discipline.
 *
 * Every word lives in src/copy/machine-readable-components.json, in reading
 * order, so the whole voice can be read in one file and edited in the browser
 * while `npm run dev` runs. This file is the arrangement; that file is the
 * writing. Nothing here should hardcode a sentence.
 *
 * Every fact came from the Design System Summary FigJam or the EGDS Components
 * and Theming file. Nothing is invented, and no metric appears here that was
 * not measured.
 */
const F = 'machine-readable-components';

/*
  Images through Astro's pipeline, same as the hero and the index tiles: WebP at
  each width, hashed filenames, and the 1.3MB PNG originals pruned from dist/.
  Never reference `.width`/`.height` off the source — that reference is what
  drags the unoptimised original into the build.

  All four are UI captures carrying text, so they render `natural` rather than
  cropped to a frame. See MediaRatio in Media.tsx.
*/
const EXPLORATION_SIZES = '(min-width: 1040px) 1000px, calc(100vw - 40px)';
const FIGURE_SIZES = '(min-width: 1040px) 1000px, calc(100vw - 40px)';
const shot = (src: ImageMetadata, sizes: string) =>
  getImage({ src, format: 'webp', widths: [480, 720, 960, 1280, 1600], sizes });

const [exVerticalOffset, exDarkFrame, exMaxHeight, figDialog] = await Promise.all([
  shot(imgVerticalOffset, EXPLORATION_SIZES),
  shot(imgDarkFrame, EXPLORATION_SIZES),
  shot(imgMaxHeight, EXPLORATION_SIZES),
  shot(imgDialog, FIGURE_SIZES)
]);

/* Index-aligned with copy.process.explorations, so the order the copy reads is
   the order the pictures appear. */
const explorationShots = [exVerticalOffset, exDarkFrame, exMaxHeight];
---

<CaseStudy
  title={c.title}
  slug="machine-readable-components"
  standfirst={c.standfirst}
  titleCopyRef={`${F}:title`}
  standfirstCopyRef={`${F}:standfirst`}
>
  <Contribution slot="contribution" items={c.contribution} copyBase={`${F}:contribution`} />

  <div class="cs-section" slot="problem">
    <SectionHeading
      standfirst={c.problem.standfirst}
      copyRef={`${F}:problem.heading`}
      standfirstCopyRef={`${F}:problem.standfirst`}
    >
      {c.problem.heading}
    </SectionHeading>
    <Prose lead>
      {c.problem.paras.map((p, i) => <p data-copy={`${F}:problem.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="process">
    <SectionHeading
      standfirst={c.process.standfirst}
      copyRef={`${F}:process.heading`}
      standfirstCopyRef={`${F}:process.standfirst`}
    >
      {c.process.heading}
    </SectionHeading>
    <Prose>
      {c.process.paras.map((p, i) => <p data-copy={`${F}:process.paras.${i}`}>{p}</p>)}
    </Prose>

    <SectionHeading level={3} copyRef={`${F}:process.explorationsHeading`}>
      {c.process.explorationsHeading}
    </SectionHeading>
    <Prose>
      <p data-copy={`${F}:process.explorationsIntro`}>{c.process.explorationsIntro}</p>
    </Prose>
    <Explorations
      layout="stack"
      copyBase={`${F}:process.explorations`}
      items={c.process.explorations.map((e, i) => ({
        title: e.title,
        why: e.why,
        image: {
          src: explorationShots[i].src,
          srcSet: explorationShots[i].srcSet.attribute,
          sizes: EXPLORATION_SIZES,
          alt: e.imageAlt,
          ratio: 'natural' as const
        }
      }))}
    />
  </div>

  <div class="cs-section" slot="interface">
    <SectionHeading
      standfirst={c.interface.standfirst}
      copyRef={`${F}:interface.heading`}
      standfirstCopyRef={`${F}:interface.standfirst`}
    >
      {c.interface.heading}
    </SectionHeading>
    <Media
      src={figDialog.src}
      srcSet={figDialog.srcSet.attribute}
      sizes={FIGURE_SIZES}
      alt={c.interface.mediaAlt}
      ratio="natural"
      caption={c.interface.mediaCaption}
      captionCopyRef={`${F}:interface.mediaCaption`}
    />
    <Prose>
      {c.interface.paras.map((p, i) => <p data-copy={`${F}:interface.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="impact">
    <SectionHeading
      standfirst={c.impact.standfirst}
      copyRef={`${F}:impact.heading`}
      standfirstCopyRef={`${F}:impact.standfirst`}
    >
      {c.impact.heading}
    </SectionHeading>
    <Metrics
      items={c.impact.metrics}
      source={c.impact.metricsSource}
      copyBase={`${F}:impact.metrics`}
      sourceCopyRef={`${F}:impact.metricsSource`}
    />
    <Prose>
      {c.impact.paras.map((p, i) => <p data-copy={`${F}:impact.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div class="cs-section" slot="hindsight">
    <Hindsight>
      {c.hindsight.paras.map((p, i) => <p data-copy={`${F}:hindsight.paras.${i}`}>{p}</p>)}
    </Hindsight>
  </div>
</CaseStudy>
