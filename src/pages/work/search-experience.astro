---
import CaseStudy from '../../layouts/CaseStudy.astro';
import { SectionHeading } from '../../components/SectionHeading';
import { Prose } from '../../components/Prose';
import { Metrics } from '../../components/Metrics';
import { Explorations } from '../../components/Explorations';
import { Hindsight } from '../../components/Hindsight';
import { Contribution } from '../../components/Contribution';
import { Media } from '../../components/Media';
import c from '../../copy/search-experience.json';

/**
 * DRAFT. Study two of two: the Product Design discipline.
 *
 * Every word lives in src/copy/search-experience.json, in reading order, so the
 * whole voice can be read in one file and edited in the browser while
 * `npm run dev` runs. This file is the arrangement; that file is the writing.
 *
 * Extracted from rohitsehmi.com/apps, which covered five separate initiatives
 * on one page. This takes the Search Experience work only, and picks up the
 * same surface again in 2025 with the App Shell motion transitions.
 *
 * Attribution confirmed 2026-08-04: Rohit was in the App Shell pod, so the
 * transitions are his. (The Motion for NCA work on the same FigJam is not, and
 * must stay out of this study.)
 *
 * STILL TO CONFIRM: that framing 2018/19 and 2025 as one continuous thread is
 * truthful. If they were unrelated pieces of work that happen to share a
 * surface, they become two sections rather than one story.
 */
const F = 'search-experience';
---

<CaseStudy
  title={c.title}
  slug="search-experience"
  standfirst={c.standfirst}
  titleCopyRef={`${F}:title`}
  standfirstCopyRef={`${F}:standfirst`}
>
  <Contribution slot="contribution" items={c.contribution} copyBase={`${F}:contribution`} />

  <div slot="problem">
    <SectionHeading
      standfirst={c.problem.standfirst}
      copyRef={`${F}:problem.heading`}
      standfirstCopyRef={`${F}:problem.standfirst`}
    >
      {c.problem.heading}
    </SectionHeading>
    <Prose lead>
      {c.problem.paras.map((p, i) => <p data-copy={`${F}:problem.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div slot="process">
    <SectionHeading
      standfirst={c.process.standfirst}
      copyRef={`${F}:process.heading`}
      standfirstCopyRef={`${F}:process.standfirst`}
    >
      {c.process.heading}
    </SectionHeading>
    <Prose>
      <p data-copy={`${F}:process.openingPara`}>{c.process.openingPara}</p>
      {/*
        Three spans rather than one string, because the middle is emphasised and
        editing is plain text: a <strong> inside a single editable string would
        be stripped the first time anyone touched it.
      */}
      <p>
        <span data-copy={`${F}:process.principle.before`}>{c.process.principle.before}</span>
        <strong data-copy={`${F}:process.principle.quote`}>{c.process.principle.quote}</strong>
        <span data-copy={`${F}:process.principle.after`}>{c.process.principle.after}</span>
      </p>
      <p data-copy={`${F}:process.closingPara`}>{c.process.closingPara}</p>
    </Prose>

    <SectionHeading level={3} copyRef={`${F}:process.explorationsHeading`}>
      {c.process.explorationsHeading}
    </SectionHeading>
    <Explorations
      copyBase={`${F}:process.explorations`}
      items={c.process.explorations.map((e) => ({
        title: e.title,
        why: e.why,
        image: { alt: e.imageAlt }
      }))}
    />
  </div>

  <div slot="interface">
    <SectionHeading
      standfirst={c.interface.standfirst}
      copyRef={`${F}:interface.heading`}
      standfirstCopyRef={`${F}:interface.standfirst`}
    >
      {c.interface.heading}
    </SectionHeading>
    <Media
      alt={c.interface.mediaAlt}
      ratio="16-9"
      caption={c.interface.mediaCaption}
      captionCopyRef={`${F}:interface.mediaCaption`}
    />
    <Prose>
      {c.interface.paras.map((p, i) => <p data-copy={`${F}:interface.paras.${i}`}>{p}</p>)}
    </Prose>
    <Media
      alt={c.interface.motionMediaAlt}
      ratio="16-9"
      caption={c.interface.motionMediaCaption}
      captionCopyRef={`${F}:interface.motionMediaCaption`}
    />
  </div>

  <div slot="impact">
    <SectionHeading
      standfirst={c.impact.standfirst}
      copyRef={`${F}:impact.heading`}
      standfirstCopyRef={`${F}:impact.standfirst`}
    >
      {c.impact.heading}
    </SectionHeading>
    <Metrics
      items={c.impact.metrics}
      source={c.impact.metricsSource}
      copyBase={`${F}:impact.metrics`}
      sourceCopyRef={`${F}:impact.metricsSource`}
    />
    <Prose>
      {c.impact.paras.map((p, i) => <p data-copy={`${F}:impact.paras.${i}`}>{p}</p>)}
    </Prose>
  </div>

  <div slot="hindsight">
    <Hindsight>
      {c.hindsight.paras.map((p, i) => <p data-copy={`${F}:hindsight.paras.${i}`}>{p}</p>)}
    </Hindsight>
  </div>
</CaseStudy>
