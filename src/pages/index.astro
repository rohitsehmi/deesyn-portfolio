---
import Base from '../layouts/Base.astro';
import { Nav } from '../components/Nav';
import { Band } from '../components/Band';
import { Footer } from '../components/Footer';
import { CaseStudyTile } from '../components/CaseStudyTile';
import { Parallax } from '../components/Parallax';
import { liveStudies, studyPath } from '../data/studies';
import { linksFor } from '../data/nav';

const links = linksFor(Astro.url.pathname);
---
<Base title="Rohit Sehmi · Product Design">
  {/*
    Sits over the hero rather than in a band of its own. `overBand` gives it the
    hero's foreground while it is transparent, because it is outside the band
    stack and would otherwise render dark text on a dark image. It drops back to
    the page's own foreground the moment it takes bg/canvas.
  */}
  <Nav client:load sticky overBand="inverse" links={links} />

  <main id="main">
    {/*
      The hero sets the tonal key and, per the hero note in the banding spec, is
      content-led rather than a band scale and does not count toward the
      alternation. inverse is not a style choice here: it resolves bg/scrim to
      70% black, which is what makes white text over this photograph clear AA.
    */}
    <Parallax
      src="/media/hero-parallax.png"
      alt="[NEEDS: replace with your own imagery. This is a Revolut marketing asset, used here to build the effect against.]"
      band="inverse"
      underNav
      priority
      client:visible
      range="exit"
      drift="140px"
    >
      <h1 class="home-hero__title">Product design, end to end.</h1>
      <p class="home-hero__standfirst">
        Two case studies. One on the design system work, one on the product work.
      </p>
    </Parallax>

    {/* base, because the hero above resolves dark. */}
    <Band role="base" scale="default">
      <ul class="work" data-count={liveStudies.length}>
        {liveStudies.map((s) => (
          <li>
            <CaseStudyTile
              title={s.title}
              summary={s.summary}
              discipline={s.discipline}
              href={studyPath(s)}
              variant="card"
              image={{ alt: `Cover image for ${s.title}` }}
            />
          </li>
        ))}
      </ul>
    </Band>
  </main>

  {/* sunken: the work band above is base. */}
  <Band role="sunken" scale="compact" bleed>
    <Footer scale="compact" />
  </Band>
</Base>

<style is:global>
  /* Type steps between styles on the scale. No clamps, no raw sizes. */
  .home-hero__title {
    margin: 0 0 var(--primitive-space-sp600);
    max-width: 16ch;
    font: var(--type-display-s);
    letter-spacing: var(--type-display-s-tracking);
    color: var(--semantic-fg-primary);
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .home-hero__title { font: var(--type-display-m); letter-spacing: var(--type-display-m-tracking); }
  }
  @media (min-width: 1024px) {
    .home-hero__title { font: var(--type-display-l); letter-spacing: var(--type-display-l-tracking); }
  }

  .home-hero__standfirst {
    margin: 0;
    max-width: 52ch;
    font: var(--type-body-l);
    letter-spacing: var(--type-body-l-tracking);
    color: var(--semantic-fg-secondary);
    text-wrap: pretty;
  }
  @media (min-width: 768px) {
    .home-hero__standfirst { font: var(--type-body-xl); letter-spacing: var(--type-body-xl-tracking); }
  }

  /* Columns follow the item count, so the last row is never ragged. */
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--primitive-layout-l64);
  }
  @media (min-width: 768px) {
    .work[data-count='2'], .work[data-count='4'] {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--primitive-layout-l48);
    }
  }
  @media (min-width: 1024px) {
    .work[data-count='3'] {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--primitive-layout-l48);
    }
  }
</style>
