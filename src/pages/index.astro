---
import Base from '../layouts/Base.astro';
import { Nav } from '../components/Nav';
import { Band } from '../components/Band';
import { Footer } from '../components/Footer';
import { CaseStudyTile } from '../components/CaseStudyTile';
import { Button } from '../components/Button';
import { Tag } from '../components/Tag';
import { Icon } from '../components/Icon';
import { liveStudies, studiesFor, studyPath, studyCopyBase } from '../data/studies';
import { BRANDS, DEFAULT_BRAND } from '../data/brands';
import { linksFor } from '../data/nav';
import copy from '../copy/home.json';
import { CLIENT_MARKS } from '../components/client-marks';
import betfairMark from '../assets/mark-betfair.png';
import grabbdMark from '../assets/mark-grabbd.png';
import contact from '../copy/contact.json';
import { archivePlates } from '../data/projects';
import { getImage } from 'astro:assets';
import workHotels from '../assets/work-hotels-apps.webp';
import workRebrand from '../assets/work-rebrand.png';
import workMobileKey from '../assets/work-mobile-key.png';
import workWearables from '../assets/work-wearables.jpg';
import workBetfairGames from '../assets/work-betfair-games.jpg';
import workBetfairSportsbook from '../assets/work-betfair-sportsbook.jpg';
import workGrabbd from '../assets/work-grabbd.png';
import workTv from '../assets/work-tv.jpg';

const links = linksFor(Astro.url.pathname);

/*
  The eight covers from rohitsehmi.com, in the order that site shows them.
  They are the work. The generated still life was standing in for this grid.
  Each one links to the page it already has there. None of these is a written
  study on this site, so they do not enter the {count} the hero speaks.

  Do not pass the source width or height into the markup. That reference pulls
  the original into dist/.
*/
const ARCHIVE_SRC = {
  'hotels-apps': workHotels,
  rebrand: workRebrand,
  'mobile-key': workMobileKey,
  wearables: workWearables,
  'betfair-games': workBetfairGames,
  'betfair-sportsbook': workBetfairSportsbook,
  grabbd: workGrabbd,
  tv: workTv
} as const;
const ARCHIVE_SIZES = '(min-width: 1024px) 440px, (min-width: 768px) 46vw, calc(100vw - 40px)';
const archiveImages = new Map(
  await Promise.all(
    copy.archive.map(async (item) => {
      const src = ARCHIVE_SRC[item.slug as keyof typeof ARCHIVE_SRC];
      if (!src) throw new Error(`index: no cover imported for archive slug "${item.slug}"`);
      const image = await getImage({
        src,
        format: 'webp',
        widths: [480, 720, 960, 1280, 1600],
        sizes: ARCHIVE_SIZES
      });
      const plate = archivePlates[item.slug];
      const dark = plate
        ? await getImage({
            src: plate,
            format: 'webp',
            widths: [480, 720, 960, 1280, 1600],
            sizes: ARCHIVE_SIZES
          })
        : undefined;
      return [item.slug, { image, dark }] as const;
    })
  )
);

/*
  Tile covers, through the same pipeline. Every study card is the same width,
  about 480 inside the measure, so they share one sizes value.
*/
/*
  How many tiles each brand actually sees, which only the hero sentence needs.

  The grid used to need it too, and emitted it as `data-count` plus a
  `data-count-<brand>` per brand so that the column count could follow the item
  count. The grid is capped at two columns now and lays out identically whatever
  the number is, so those attributes have no consumer and are gone. See the note
  on .work in the stylesheet below.

  The hero still counts, because it says the number out loud.

  It was written once, for the default brand, and copied, so wise.deesyn.com read
  "Two case studies, for Wise." above three tiles: the placeholder study is Wise
  only and nothing connected the prose to the list. CLAUDE.md had already called
  this shape of bug, that anything derived from how many things a brand sees has
  it waiting.

  So the number is substituted from studiesFor(), never typed. The copy keeps the
  whole sentence in one editable string around a {count} token, which is the
  pattern how-this-was-built.astro already uses for its build-time figures.
*/
const counts = Object.fromEntries(BRANDS.map((b) => [b, studiesFor(b).length])) as Record<
  (typeof BRANDS)[number],
  number
>;
const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];

const heroTitleFor = (brand: (typeof BRANDS)[number]) => {
  const raw: string =
    brand === DEFAULT_BRAND ? copy.heroTitle : (copy.brands as any)[brand].heroTitle;

  /*
    A hardcoded number renders as a plausible sentence and is invisible in review
    — which is exactly how the original survived. Refuse it at build time rather
    than substituting nothing and shipping whichever count was typed.
  */
  if (!raw.includes('{count}')) {
    /*
      The default title names the practice and does not count. A title that
      counts without the token is the old bug: a typed number, right for one
      hostname and wrong for the rest. Partner titles still carry {count}.
    */
    if (/\d/.test(raw) || /\b(?:one|two|three|four|five|six|seven|eight|nine)\b/i.test(raw)) {
      throw new Error(
        `index: the ${brand} hero title counts without the {count} token. ` +
        `Each brand is offered a different number of studies, so a typed number ` +
        `is right for one hostname and wrong for the rest. Edit it in src/copy/home.json.`
      );
    }
    return raw;
  }

  const n = counts[brand];

  /*
    The noun is plural in the copy, so one study would render "One case studies".
    Every brand has at least two today and nextStudy() already guards the same
    boundary, so this fails the build with the instruction rather than carrying a
    pluralisation engine for a case that does not exist yet.
  */
  if (n === 1) {
    throw new Error(
      `index: ${brand} is offered one study, and the hero copy reads "case studies". ` +
      `Rewrite that string in src/copy/home.json for the singular.`
    );
  }

  /*
    Capitalised only when the token opens the sentence, which is where all three
    brands have it today. Doing it unconditionally would silently produce "Just
    Two case studies" the first time someone writes a lead-in.
  */
  const word = NUMBER_WORDS[n] ?? String(n);
  const cased = raw.startsWith('{count}') ? word.charAt(0).toUpperCase() + word.slice(1) : word;
  return raw.replace('{count}', cased);
};

/*
  One word of the headline carries the lime bar. Same face as the rest of the title.
  The word lives in the copy so a partner title can mark its own name
  ("Wise") without the template guessing which token is the accent.
*/
const heroAccentFor = (brand: (typeof BRANDS)[number]) =>
  brand === DEFAULT_BRAND
    ? copy.heroAccent
    : ((copy.brands as Record<string, { heroAccent?: string }>)[brand].heroAccent ?? '');

const titleParts = (sentence: string, accent: string) => {
  if (!accent) return [{ text: sentence, mark: false }];
  const at = sentence.indexOf(accent);
  if (at < 0) return [{ text: sentence, mark: false }];
  /* Keep the following period on the italic word, so a screen reader does not
     pause between the word and the stop. */
  let end = at + accent.length;
  while (end < sentence.length && '.,'.includes(sentence[end])) end += 1;
  return [
    { text: sentence.slice(0, at), mark: false },
    { text: sentence.slice(at, end), mark: true },
    { text: sentence.slice(end), mark: false }
  ].filter((part) => part.text.length > 0);
};

const heroSecondary = copy.heroSecondary;

/*
  Three rooms, one per study. Sage is the product card. Sky and coral are the
  two systems cards, both pale, so the row is tinted without becoming a chart.
  The older projects stay on the white surface.
*/
const TINT: Record<string, 'sky' | 'sage' | 'coral'> = {
  'machine-readable-components': 'sky',
  'making-the-app-testable': 'sage',
  'scaling-a-system': 'coral'
};

/*
  The standfirst introduces the practice. It does not count, and it does not
  describe how the page is arranged.

  It used to: "{systems} case studies on design systems, and {product} on
  product design." That described the three case studies and said nothing
  about the earlier projects on the same page, so "one on product design"
  stopped being true of the work the moment those eight cards were here.

  A typed number is still refused. "Two" and "one" are plausible and invisible
  in a diff, which is how "One on the design system" shipped on Wise and Healf
  above two design-system studies. The partner titles still carry {count}.
*/
const heroStandfirstFor = () => {
  const raw: string = copy.heroStandfirst;
  if (/\d/.test(raw) || /\b(?:one|two|three|four|five|six|seven|eight|nine)\b/i.test(raw)) {
    throw new Error(
      `index: the hero standfirst counts with a typed number. ` +
      `That sentence went stale once and described the case studies while the ` +
      `earlier projects sat under them. Edit it in src/copy/home.json.`
    );
  }
  return raw;
};

/*
  Brands reading identically share ONE span, via the whitespace-separated list
  `data-brand-only` has matched with ~= since 2026-08-17.

  The title renders one span per brand because all three differ — each names its
  own company. These do not: Wise and Healf are offered the same mix, so writing
  one span each would put the identical sentence in the raw HTML twice. That is
  the audience the space separator on the title was added for, an agent fetching
  the page and never running the stylesheet, and a duplicate paragraph reads as
  a stutter to exactly that reader.
*/
const standfirstsByBrand = BRANDS.reduce((acc, brand) => {
  const sentence = heroStandfirstFor();
  acc.set(sentence, [...(acc.get(sentence) ?? []), brand]);
  return acc;
}, new Map<string, string[]>());

const COVER_SIZES = '(min-width: 1024px) 480px, (min-width: 768px) 45vw, calc(100vw - 40px)';
const covers = new Map(
  await Promise.all(
    liveStudies.filter((s) => s.cover).map(async (s) => {
      const sizes = COVER_SIZES;
      const light = await getImage({
        src: s.cover!.src,
        format: 'webp',
        widths: [480, 720, 960, 1280, 1600],
        sizes
      });
      const dark = s.cover!.srcDark
        ? await getImage({
            src: s.cover!.srcDark,
            format: 'webp',
            widths: [480, 720, 960, 1280, 1600],
            sizes
          })
        : undefined;
      return [
        s.slug,
        {
          src: light.src,
          srcSet: light.srcSet.attribute,
          srcDark: dark?.src,
          srcSetDark: dark?.srcSet.attribute,
          ratio: s.cover!.ratio,
          sizes
        }
      ] as const;
    })
  )
);
---
<Base
  title="Rohit Sehmi · Product and design systems"
  socialTitle="Product and design systems"
  description={copy.heroStandfirst}
  pageEnd="sunken"
>
  {/*
    Transparent over the inverse hero, then the page canvas once it scrolls.
    The bar is outside the band, so the homepage stylesheet paints its top
    state to match that hero. onMedia would not flip with the theme.
  */}
  <Nav client:load sticky links={links} />

  <div class="pointer-arrow" data-pointer-arrow aria-hidden="true">
    <span class="pointer-arrow__disc">
      <Icon name="arrow-thin-right" size={24} />
    </span>
  </div>

  <main id="main">
    {/*
      One screen. The headline owns it, the companies sit on its floor.
      Inverse, then the work returns to base, which is the legal step out.
    */}
    <Band role="inverse" scale="compact">
      <canvas class="home-shader" aria-hidden="true"></canvas>
      <canvas class="home-field" aria-hidden="true"></canvas>
      <div class="home-stage">
      <div class="home-hero">
        <h1 class="home-hero__title">
          {BRANDS.map((brand, i) => (
            <>
              {i > 0 && ' '}
              <span data-brand-only={brand}>
                {titleParts(heroTitleFor(brand), heroAccentFor(brand)).map((part) =>
                  part.mark
                    ? <em class="home-hero__accent">{part.text}</em>
                    : <span>{part.text}</span>
                )}
              </span>
            </>
          ))}
        </h1>
        <p class="home-hero__standfirst">
          {[...standfirstsByBrand].map(([sentence, brands], i) => (
            <>
              {i > 0 && ' '}
              <span data-brand-only={brands.join(' ')} data-copy="home:heroStandfirst">{sentence}</span>
            </>
          ))}
        </p>
        <p class="home-hero__availability" data-copy="home:heroAvailability">{copy.heroAvailability}</p>
        <div class="home-hero__actions">
          <Button href="#work" variant="secondary" size="lg" data-copy="home:heroSecondary">{heroSecondary}</Button>
        </div>
      </div>

      {/*
        Employers, plus Vrbo and Grabbd, which the work itself names.
        The partner hostnames are not in this list. The second list is the
        loop, hidden from the accessibility tree. Reduced motion drops it.
      */}
      <div class="clients" data-clients>
        <p class="clients__label" id="clients-label" data-copy="home:clientsLabel">{copy.clientsLabel}</p>
        <div class="clients__viewport" role="group" aria-labelledby="clients-label">
          <div class="clients__track">
            {[false, true].map((clone) => (
              <ul class="clients__list" aria-hidden={clone ? 'true' : undefined} inert={clone ? true : undefined}>
                {copy.clients.map((item) => {
                  const mark = CLIENT_MARKS[item.mark as keyof typeof CLIENT_MARKS];
                  const word = !mark && item.mark !== 'betfair' && item.mark !== 'grabbd';
                  return (
                    <li>
                      <span class="clients__item">
                        {mark && (
                          <svg
                            class="clients__svg"
                            viewBox={mark.viewBox}
                            aria-hidden="true"
                            data-mark={item.mark}
                            set:html={mark.body}
                          />
                        )}
                        {item.mark === 'betfair' && (
                          <span
                            class="clients__betfair"
                            data-mark="betfair"
                            aria-hidden="true"
                            style={`--betfair: url('${betfairMark.src}')`}
                          />
                        )}
                        {item.mark === 'grabbd' && (
                          <img
                            class="clients__grabbd"
                            data-mark="grabbd"
                            src={grabbdMark.src}
                            width={grabbdMark.width}
                            height={grabbdMark.height}
                            alt=""
                          />
                        )}
                        <span class:list={['clients__name', { 'clients__name--shown': word }]}>{item.name}</span>
                      </span>
                    </li>
                  );
                })}
              </ul>
            ))}
          </div>
        </div>
      </div>
      </div>
      <div class="home-ground-fade" aria-hidden="true"></div>
    </Band>

    <Band role="base" scale="compact">
      <div class="home-offers" id="work">
        <h2 data-copy="home:offersTitle">{copy.offersTitle}</h2>
        <ul>
          {copy.offers.map((item, i) => {
            const mark = (['brands', 'read', 'product'] as const)[i];
            return (
              <li>
                <a href={item.href}>
                  <span class="home-offers__mark" data-mark={mark} aria-hidden="true">
                    {mark === 'product' ? <span></span> : <><span></span><span></span><span></span></>}
                  </span>
                  <span class="home-offers__text">
                    <span class="home-offers__title" data-copy={`home:offers.${i}.title`}>{item.title}</span>
                    <span class="home-offers__summary" data-copy={`home:offers.${i}.summary`}>{item.summary}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
      {/*
        No count on the list, deliberately, and this is where one used to be.

        The grid picked its columns from how many tiles there were, so the count
        had to be emitted once per brand: each brand sees a different number, and
        `display: none` removes a grid ITEM but cannot remove a TRACK, so a tile
        hidden from a brand still left an empty column on that brand's hostname.

        Capping the grid at two columns removes the dependency rather than
        guarding it. Nothing here needs to know how many tiles this brand sees,
        so nothing can get that number wrong.
      */}
      <ul class="work">
        {/*
          Every live study across every brand, with the brand-specific ones
          marked so CSS can drop them. It has to be this way round: one build
          answers every hostname, so the tile a brand does not get still ships
          in the HTML and is hidden rather than never rendered.

          data-brand-only sits on the <li> rather than on the tile, so the grid
          item goes with it. Hiding the tile alone would leave an empty cell,
          which on a two-column grid is not a smaller list — it is a hole.

          These three sit above the older projects. They are the longer reads,
          and the most recent work for now.
        */}
        {liveStudies.map((s) => (
          <li data-tint={TINT[s.slug]} {...(s.brands ? { 'data-brand-only': s.brands.join(' ') } : {})}>
            <CaseStudyTile
              title={s.title}
              summary={s.summary}
              discipline={s.discipline}
              href={studyPath(s)}
              variant="card"
              copyBase={studyCopyBase(s)}
              mark={copy.studyBadge}
              markCopyRef="home:studyBadge"
              cue={false}
              image={{
                src: covers.get(s.slug)?.src,
                srcSet: covers.get(s.slug)?.srcSet,
                srcDark: covers.get(s.slug)?.srcDark,
                srcSetDark: covers.get(s.slug)?.srcSetDark,
                sizes: covers.get(s.slug)?.sizes,
                alt: s.cover?.alt ?? `Cover image for ${s.title}`,
                ratio: '4-3'
              }}
            />
          </li>
        ))}
      </ul>
      <ul class="archive">
          {copy.archive.map((item, i) => {
            const shot = archiveImages.get(item.slug)!;
            return (
              <li data-archive={item.slug}>
                <article class="archive__card">
                  <span class="archive__media">
                    <img
                      src={shot.image.src}
                      srcset={shot.image.srcSet.attribute}
                      sizes={ARCHIVE_SIZES}
                      alt={item.alt}
                      loading="lazy"
                      decoding="async"
                      data-theme-img={shot.dark ? 'light' : undefined}
                    />
                    {shot.dark && (
                      <img
                        src={shot.dark.src}
                        srcset={shot.dark.srcSet.attribute}
                        sizes={ARCHIVE_SIZES}
                        alt={item.alt}
                        loading="lazy"
                        decoding="async"
                        data-theme-img="dark"
                      />
                    )}
                    <span class="archive__tag">
                      <Tag copyRef={`home:archive.${i}.tag`}>{item.tag}</Tag>
                    </span>
                  </span>
                  <span class="archive__body">
                    <span class="archive__title">
                      <a class="archive__link" href={item.href} data-copy={`home:archive.${i}.title`}>{item.title}</a>
                    </span>
                    <span class="archive__summary" data-copy={`home:archive.${i}.summary`}>{item.summary}</span>
                  </span>
                </article>
              </li>
            );
          })}
        </ul>
    </Band>
  </main>

  {/*
    A surface, not a band. Highlight is a colour, and a band would swap the
    foreground to the other theme, which puts paper type on yellow at 1.17:1.
    It sits between base and sunken. The bands the linter reads are inverse,
    then base, then sunken. Inverse has to return to base, and it does.
  */}
  <section class="home-close">
    <canvas class="home-shader" aria-hidden="true"></canvas>
    <div class="measure home-close__inner">
      <h2 data-copy="contact:standfirst">{contact.standfirst}</h2>
      <Button href="/contact" size="lg" data-copy="contact:title">{contact.title}</Button>
    </div>
  </section>

  {/* sunken: the work band above is base. */}
  <Band role="sunken" scale="compact" bleed>
    <Footer scale="compact" currentPath={Astro.url.pathname} />
  </Band>
</Base>

<script>
  import { bootHomeMotion } from '../components/home-motion';
  import { bootHeroField } from '../components/home-field';
  import { bootHomeShader } from '../components/home-shader';

  bootHomeMotion();
  bootHeroField();
  bootHomeShader();
</script>

<style is:global>
  /*
    The hero is one blend, from the field colour down into the signal.
    It is mixed in oklch so the middle stays blue, then green, and never
    a grey shelf. The shift is slow behind the type and solid signal
    under the marks. The band is pulled up under the fixed bar;
    padding-top puts the type back below it. The extra top padding
    mirrors Band.css compact scale.
  */
  main > .band[data-band='inverse'] {
    position: relative;
    margin-top: calc(var(--primitive-size-nav) * -1);
    padding-top: calc(var(--primitive-size-nav) * 2 + var(--primitive-layout-l40));
    background: linear-gradient(
      to bottom in oklch,
      var(--semantic-band-base) 0%,
      color-mix(in oklch, var(--semantic-band-base) 96%, var(--semantic-highlight)) 26%,
      color-mix(in oklch, var(--semantic-band-base) 88%, var(--semantic-highlight)) 42%,
      color-mix(in oklch, var(--semantic-band-base) 68%, var(--semantic-highlight)) 54%,
      color-mix(in oklch, var(--semantic-band-base) 42%, var(--semantic-highlight)) 64%,
      color-mix(in oklch, var(--semantic-band-base) 16%, var(--semantic-highlight)) 74%,
      var(--semantic-highlight) 84%,
      var(--semantic-highlight) 100%
    );
  }
  @media (min-width: 768px) {
    main > .band[data-band='inverse'] {
      padding-top: calc(var(--primitive-size-nav) * 2 + var(--primitive-layout-l64));
    }
  }
  @media (min-width: 1024px) {
    main > .band[data-band='inverse'] {
      padding-top: calc(var(--primitive-size-nav) * 2 + var(--primitive-layout-l80));
    }
  }
  /*
    Specks in the field, behind the type. The mask keeps them out of the
    bar and out of the pool the companies sit on. The colour is the band's
    own foreground, so the field flips with the theme.
  */
  /*
    The mesh sits under the specks. Its stops are the band's own surfaces,
    so the type keeps its contrast while the field moves. The mask is the
    field's mask: nothing in the bar, and the lime floor stays the gradient.
  */
  .home-shader {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    --shader-a: var(--semantic-band-base);
    --shader-b: var(--semantic-band-sunken);
    --shader-c: var(--semantic-bg-surface);
    --shader-d: var(--semantic-band-base);
  }
  .home-shader[data-live='true'] {
    opacity: 1;
    transition: opacity var(--semantic-duration-overlay) var(--semantic-easing-out);
  }
  .home-shader[data-failed] { display: none; }
  main > .band[data-band='inverse'] .home-shader {
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--primitive-size-nav) * 2),
      black calc(var(--primitive-size-nav) * 2 + var(--primitive-layout-l64)),
      black 46%,
      transparent 66%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--primitive-size-nav) * 2),
      black calc(var(--primitive-size-nav) * 2 + var(--primitive-layout-l64)),
      black 46%,
      transparent 66%
    );
  }
  .home-field {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--semantic-fg-primary);
    --field-cool: var(--primitive-deesyn-sky);
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--primitive-size-nav) * 2),
      black calc(var(--primitive-size-nav) * 2 + var(--primitive-layout-l64)),
      black 46%,
      transparent 66%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--primitive-size-nav) * 2),
      black calc(var(--primitive-size-nav) * 2 + var(--primitive-layout-l64)),
      black 46%,
      transparent 66%
    );
  }
  @media (prefers-reduced-motion: reduce) {
    .home-field, .home-shader { display: none; }
  }
  .home-stage { position: relative; z-index: 1; }
  /*
    The lime floor eases into the next band as that band arrives. The height
    follows the scroll, so a short move only softens the join. The ramp starts
    on the ground colour at no alpha: the keyword transparent is black, and a
    fade from black muddies the lime. Most of the ramp stays clear, so the
    marks keep the floor and only the edge settles.
  */
  .home-ground-fade {
    position: absolute;
    z-index: 0;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(var(--ground-fade) * 1vh);
    pointer-events: none;
    --ground-fade: 0;
    --ground-fade-color: var(--semantic-bg-inverse);
    background: linear-gradient(
      to bottom,
      rgb(from var(--ground-fade-color) r g b / 0) 0%,
      rgb(from var(--ground-fade-color) r g b / 0.04) 38%,
      rgb(from var(--ground-fade-color) r g b / 0.16) 62%,
      rgb(from var(--ground-fade-color) r g b / 0.46) 80%,
      rgb(from var(--ground-fade-color) r g b / 0.82) 92%,
      var(--ground-fade-color) 100%
    );
  }
  /*
    The work was sitting on the yellow paper, and a whole screen of it read
    as a wash. This ground is a little navy in white, so it stays in the
    palette and the lime is the only warm note. The bar and the fade use
    the same ground, or the join turns yellow again. The footer is the
    navy itself, with the light type, so the page ends where the hero began.
  */
  /* --home-ground lives in base.css. Every page uses it, not only this one. */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) main > .band[data-band='base'] {
      background: var(--home-ground);
    }
    :root:not([data-theme='dark']) .nav[data-state='scrolled'] {
      background: var(--home-ground);
    }
    :root:not([data-theme='dark']) main ~ .band[data-band='sunken'] {
      background: var(--primitive-deesyn-ink);
      color: var(--primitive-deesyn-paper);
    }
    :root:not([data-theme='dark']) main ~ .band[data-band='sunken'] .footer__copy {
      color: var(--primitive-deesyn-mist);
    }
    /* The extra :root is specificity. The shared ground rule is (0,3,0) and
       would paint the overscroll grey. Past the navy footer it stays navy. */
    html:root:root:not([data-theme='dark']) {
      background: var(--primitive-deesyn-ink);
    }
    :root:not([data-theme='dark']) body {
      background: var(--home-ground);
    }
    :root:not([data-theme='dark']) .home-ground-fade {
      --ground-fade-color: var(--home-ground);
    }
  }
  :root[data-theme='light'] main > .band[data-band='base'] {
    background: var(--home-ground);
  }
  :root[data-theme='light'] .nav[data-state='scrolled'] {
    background: var(--home-ground);
  }
  :root[data-theme='light'] main ~ .band[data-band='sunken'] {
    background: var(--primitive-deesyn-ink);
    color: var(--primitive-deesyn-paper);
  }
  :root[data-theme='light'] main ~ .band[data-band='sunken'] .footer__copy {
    color: var(--primitive-deesyn-mist);
  }
  html:root:root[data-theme='light'] {
    background: var(--primitive-deesyn-ink);
  }
  :root[data-theme='light'] body {
    background: var(--home-ground);
  }
  :root[data-theme='light'] .home-ground-fade {
    --ground-fade-color: var(--home-ground);
  }

  /*
    Transparent bar on the hero. The band owns the foreground of what is
    inside it, and the bar is not inside it, so these few assignments follow
    the same flip: paper on the navy hero, ink on the paper hero.
    Scrolled state does not match, and the bar returns to the page canvas.
  */
  /*
    The bar opens at twice its height, and the lockup with it, so the mark
    reads before the headline does. CV and Contact stay on the small size.
    Scrolling leaves data-state top, and both settle back to the compact bar.
  */
  /*
    The scrolled bar is the same ground as the page under it. The 1px rule
    that arrives with that state is the only thing left to see, so it reads
    as a line appearing on scroll.
  */
  :root .nav[data-state='scrolled'] { border-bottom-color: transparent; }
  .nav[data-state='top'] { height: calc(var(--primitive-size-nav) * 2); }
  .nav[data-state='top'] .nav__logo .logo { height: var(--primitive-size-s64); }
  .nav[data-state='top'] .logo-brand { gap: var(--primitive-space-sp500); }
  .nav[data-state='top'] .logo-brand__x {
    width: var(--primitive-size-s24);
    height: var(--primitive-size-s24);
  }
  .nav[data-state='top'] .logo-brand__word {
    font-family: var(--type-display-s-family);
    font-weight: var(--type-display-s-weight);
    font-size: var(--type-display-s-size);
    letter-spacing: var(--type-display-s-tracking);
    /* type-lint-allow: the word aligns to the mark, and the display line-height would drop it */
    line-height: 1;
  }
  .nav[data-state='top'] .nav__logo,
  .nav[data-state='top'] .nav__links .button[data-variant='ghost'],
  .nav[data-state='top'] .nav__menu .icon-button {
    color: var(--semantic-fg-on-ink);
  }
  .nav[data-state='top'] .nav__cta .button {
    background: var(--semantic-fg-on-ink);
    color: var(--semantic-fg-primary);
  }
  /*
    The ink has to move with the fill. A snap to paper while the bar is still
    paper hides the wordmark, and it only comes back once the fill has gone.
    Hover keeps the short press duration; this longer one is the state change.
  */
  @media (prefers-reduced-motion: no-preference) {
    .nav[data-state='top'] .nav__logo {
      transition: color var(--semantic-duration-dropdown) var(--semantic-easing-out);
    }
    .nav[data-state='scrolled'] .nav__logo {
      transition: color var(--semantic-duration-counter) var(--semantic-easing-drawer);
    }
    .nav[data-state='top'] .nav__menu .icon-button {
      transition:
        transform var(--semantic-duration-press) var(--semantic-easing-out),
        background-color var(--semantic-duration-press) var(--semantic-easing-out),
        color var(--semantic-duration-dropdown) var(--semantic-easing-out);
    }
    .nav[data-state='scrolled'] .nav__menu .icon-button {
      transition:
        transform var(--semantic-duration-press) var(--semantic-easing-out),
        background-color var(--semantic-duration-press) var(--semantic-easing-out),
        color var(--semantic-duration-counter) var(--semantic-easing-drawer);
    }
    .nav[data-state='top'] .nav__links .button[data-variant='ghost'],
    .nav[data-state='top'] .nav__cta .button {
      transition:
        transform var(--semantic-duration-press) var(--semantic-easing-out),
        background-color var(--semantic-duration-dropdown) var(--semantic-easing-out),
        color var(--semantic-duration-dropdown) var(--semantic-easing-out),
        border-radius var(--semantic-duration-press) var(--semantic-easing-out);
    }
    .nav[data-state='scrolled'] .nav__links .button[data-variant='ghost'],
    .nav[data-state='scrolled'] .nav__cta .button {
      transition:
        transform var(--semantic-duration-press) var(--semantic-easing-out),
        background-color var(--semantic-duration-counter) var(--semantic-easing-drawer),
        color var(--semantic-duration-counter) var(--semantic-easing-drawer),
        border-radius var(--semantic-duration-press) var(--semantic-easing-out);
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .nav[data-state='top'] .nav__links .button[data-variant='ghost']:hover,
    .nav[data-state='top'] .nav__cta .button:hover,
    .nav[data-state='scrolled'] .nav__links .button[data-variant='ghost']:hover,
    .nav[data-state='scrolled'] .nav__cta .button:hover {
      transition:
        transform var(--semantic-duration-press) var(--semantic-easing-out),
        background-color var(--semantic-duration-press) var(--semantic-easing-out),
        color var(--semantic-duration-press) var(--semantic-easing-out),
        border-radius var(--semantic-duration-press) var(--semantic-easing-out);
    }
  }
  /* The bar is clear over navy. Ink would vanish; the arc takes the lime. */
  .nav[data-state='top'] .nav__cta { --nav-cta-arc: var(--semantic-highlight); }
  @media (hover: hover) and (pointer: fine) {
    .nav[data-state='top'] .nav__links .button[data-variant='ghost']:hover,
    .nav[data-state='top'] .nav__menu .icon-button:hover {
      background: color-mix(in srgb, var(--semantic-fg-on-ink) 14%, transparent);
    }
    .nav[data-state='top'] .nav__cta .button:hover {
      background: var(--semantic-bg-highlight);
      color: var(--semantic-fg-on-highlight);
    }
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .nav[data-state='top'] .nav__logo,
    :root:not([data-theme='light']) .nav[data-state='top'] .nav__links .button[data-variant='ghost'],
    :root:not([data-theme='light']) .nav[data-state='top'] .nav__menu .icon-button {
      color: var(--semantic-fg-on-highlight);
    }
    :root:not([data-theme='light']) .nav[data-state='top'] .nav__cta .button {
      background: var(--semantic-fg-on-highlight);
      color: var(--semantic-fg-on-ink);
    }
    :root:not([data-theme='light']) .nav[data-state='top'] .nav__links .button[data-variant='ghost']:hover,
    :root:not([data-theme='light']) .nav[data-state='top'] .nav__menu .icon-button:hover {
      background: color-mix(in srgb, var(--semantic-fg-on-highlight) 10%, transparent);
    }
  }
  :root[data-theme='dark'] .nav[data-state='top'] .nav__logo,
  :root[data-theme='dark'] .nav[data-state='top'] .nav__links .button[data-variant='ghost'],
  :root[data-theme='dark'] .nav[data-state='top'] .nav__menu .icon-button {
    color: var(--semantic-fg-on-highlight);
  }
  :root[data-theme='dark'] .nav[data-state='top'] .nav__cta .button {
    background: var(--semantic-fg-on-highlight);
    color: var(--semantic-fg-on-ink);
  }
  :root[data-theme='dark'] .nav[data-state='top'] .nav__links .button[data-variant='ghost']:hover,
  :root[data-theme='dark'] .nav[data-state='top'] .nav__menu .icon-button:hover {
    background: color-mix(in srgb, var(--semantic-fg-on-highlight) 10%, transparent);
  }

  .home-stage {
    min-height: calc(100dvh - var(--primitive-size-nav) - (var(--primitive-layout-l40) * 2));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--primitive-layout-l64);
  }
  @media (min-width: 768px) {
    .home-stage {
      min-height: calc(100dvh - var(--primitive-size-nav) - (var(--primitive-layout-l64) * 2));
    }
  }
  @media (min-width: 1024px) {
    .home-stage {
      min-height: calc(100dvh - var(--primitive-size-nav) - (var(--primitive-layout-l80) * 2));
    }
  }

  /* Steps up the scale. No clamps. */
  .home-hero__title {
    /* The accent bar is painted in padding under the last word, and that
       padding hangs out of the line box. This gap keeps it off the standfirst. */
    margin: 0 0 var(--primitive-layout-l48);
    max-width: 14ch;
    font: var(--type-display-s);
    letter-spacing: var(--type-display-s-tracking);
    color: var(--semantic-fg-primary);
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .home-hero__title {
      max-width: 16ch;
      font: var(--type-display-m);
      letter-spacing: var(--type-display-m-tracking);
    }
  }
  @media (min-width: 1024px) {
    .home-hero__title {
      max-width: 16ch;
      font: var(--type-display-xl);
      letter-spacing: var(--type-display-xl-tracking);
    }
  }

  /*
    The bar sits under the word, in the padding. It used to start at 86% and
    run through the bottoms of the letters. Those letters are paper, and
    paper on this pale bar is about 1:1. The marker is not text, so it can
    stay pale once it is clear of the glyphs.
  */
  .home-hero__accent {
    font-family: var(--type-accent-italic-family);
    font-weight: var(--type-accent-italic-weight);
    font-style: normal;
    letter-spacing: var(--type-accent-italic-tracking);
    padding-bottom: 0.2em;
    background-image: linear-gradient(
      118deg,
      color-mix(in srgb, var(--primitive-deesyn-sage) 78%, var(--semantic-fg-on-ink)),
      color-mix(in srgb, var(--semantic-highlight) 34%, var(--semantic-fg-on-ink))
    );
    background-repeat: no-repeat;
    background-position: left bottom;
    /* Full bar until the motion script wipes it. Missing JS keeps the bar. */
    --accent-wipe: 100%;
    background-size: var(--accent-wipe) 0.1em;
  }
  /* Secondary is the band's own. The old 32ch cap was for type on the photograph. */
  .home-hero__standfirst,
  .home-hero__availability {
    margin: 0;
    max-width: 42ch;
    font: var(--type-body-l);
    letter-spacing: var(--type-body-l-tracking);
    color: var(--semantic-fg-secondary);
    text-wrap: pretty;
  }
  .home-hero__availability {
    margin: var(--primitive-space-sp200) 0 0;
    font: var(--type-ui-body);
    letter-spacing: var(--type-ui-body-tracking);
  }
  /*
    Dark theme flips this band to the pale ground, so secondary is graphite.
    That is 5.6:1 on the paper and 4.9:1 where the gradient reaches the lime,
    and it reads as faint next to the navy headline. Primary is navy here.
    Light theme keeps the mist, which is 8.9:1 on the navy hero.
  */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .home-hero__standfirst,
    :root:not([data-theme='light']) .home-hero__availability {
      color: var(--semantic-fg-primary);
    }
  }
  :root[data-theme='dark'] .home-hero__standfirst,
  :root[data-theme='dark'] .home-hero__availability {
    color: var(--semantic-fg-primary);
  }
  @media (min-width: 768px) {
    .home-hero__standfirst { font: var(--type-body-xl); letter-spacing: var(--type-body-xl-tracking); }
  }

  /* Lime is a surface. Navy on it clears the pale ground; paper on it does not. */
  .home-hero__actions .button[data-variant='secondary'] {
    background: var(--semantic-bg-highlight);
    color: var(--semantic-fg-on-highlight);
  }
  @media (hover: hover) and (pointer: fine) {
    .home-hero__actions .button[data-variant='secondary']:hover {
      background: color-mix(in srgb, var(--semantic-bg-highlight) 82%, var(--semantic-fg-on-highlight));
    }
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--primitive-space-sp400);
    margin-top: var(--primitive-space-sp800);
  }

  .archive {
    list-style: none;
    margin: var(--primitive-layout-l128) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--primitive-layout-l48) var(--primitive-space-sp600);
    scroll-margin-top: calc(var(--primitive-size-nav) + var(--primitive-space-sp600));
  }
  /* Eight covers, one shape. Two columns, so a row never ends on a single hole. */
  @media (min-width: 768px) {
    .archive { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .archive__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    height: 100%;
    color: var(--semantic-fg-primary);
    background: var(--semantic-bg-surface);
    border-radius: var(--primitive-radius-r32);
    overflow: hidden;
    transition: transform var(--semantic-duration-press) var(--semantic-easing-out);
    -webkit-tap-highlight-color: transparent;
  }
  .archive__link {
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
  }
  .archive__link::after { content: ''; position: absolute; inset: 0; }
  .archive__card:has(.archive__link:focus-visible) {
    outline: 2px solid var(--semantic-border-focus);
    outline-offset: 4px;
    border-radius: var(--primitive-radius-r32);
  }
  .archive__link:focus-visible { outline: none; }
  .archive__card:has(.archive__link:active) { transform: scale(0.985); }
  .archive__media {
    position: relative;
    overflow: hidden;
    flex: none;
    border-radius: var(--primitive-radius-r32);
    /* The cut-out plate is transparent, so this is the ground the device sits on. */
    background: var(--semantic-bg-surface);
  }
  /*
    The tag sits on the picture, bottom left, the same place as a case study.
    The widget wash disappears on a photograph, so the chip takes the surface.
    The bottom inset matches the case-study chips: close to the corner,
    still on the picture.
  */
  .archive__tag {
    position: absolute;
    z-index: 1;
    left: var(--primitive-space-sp500);
    bottom: var(--primitive-space-sp600);
    max-width: calc(100% - 2 * var(--primitive-space-sp500));
    pointer-events: none;
  }
  .archive__tag .tag {
    background: var(--semantic-bg-surface);
    color: var(--semantic-fg-primary);
    border: 1px solid var(--semantic-border-strong);
  }
  .archive__media img {
    --pan-x: 0px;
    --pan-y: 0px;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transform: translate3d(var(--pan-x), var(--pan-y), 0);
    transition: transform var(--semantic-duration-dropdown) var(--semantic-easing-out);
  }
  /*
    Same cascade as Media.css. A picture with no dark plate has no
    data-theme-img, so none of this matches it. The hidden one is
    display:none, so a screen reader meets the picture once.
  */
  .archive__media img[data-theme-img='dark'] { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .archive__media img[data-theme-img='light'] { display: none; }
    :root:not([data-theme='light']) .archive__media img[data-theme-img='dark'] { display: block; }
  }
  [data-theme='dark'] .archive__media img[data-theme-img='light'] { display: none; }
  [data-theme='dark'] .archive__media img[data-theme-img='dark'] { display: block; }
  [data-theme='light'] .archive__media img[data-theme-img='light'] { display: block; }
  [data-theme='light'] .archive__media img[data-theme-img='dark'] { display: none; }
  /* The scale makes room for the pointer shift. Both live on one transform so they do not fight. */
  @media (hover: hover) and (pointer: fine) {
    .archive__card:hover .archive__media img {
      transform: translate3d(var(--pan-x), var(--pan-y), 0) scale(1.06);
    }
  }
  .archive__title {
    width: fit-content;
    font-family: var(--type-heading-m-family);
    font-weight: var(--type-heading-m-weight);
    font-size: var(--type-heading-m-size);
    letter-spacing: var(--type-heading-m-tracking);
    line-height: var(--type-heading-m-line);
    text-wrap: balance;
    background-image: linear-gradient(var(--semantic-highlight), var(--semantic-highlight));
    background-repeat: no-repeat;
    background-position: 0 92%;
    background-size: 0 0.42em;
    transition: background-size var(--semantic-duration-dropdown) var(--semantic-easing-out);
  }
  @media (min-width: 768px) {
    .archive__title {
      font-size: var(--type-heading-l-size);
      letter-spacing: var(--type-heading-l-tracking);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .archive__card:hover .archive__title { background-size: 100% 0.42em; }
  }
  .archive__card:has(.archive__link:focus-visible) .archive__title { background-size: 100% 0.42em; }
  .archive__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--primitive-space-sp200);
    padding: var(--primitive-space-sp1000);
  }
  .archive__summary {
    margin: 0;
    max-width: 36ch;
    font: var(--type-body-l);
    letter-spacing: var(--type-body-l-tracking);
    color: var(--semantic-fg-secondary);
    text-wrap: pretty;
  }

  /*
    A loop, not an interaction. The duration scale tops out at 800ms, which
    would blur the marks, so the period stays a literal. The clone makes the
    -50% land on an identical list. The start inset keeps the first mark out
    of the edge fade, and the trailing space is the gap minus that inset, so
    the seam equals the gap between marks.
  */
  /*
    The wash is the band behind this row. The marks take the signal
    colour so they stay readable on the lime at the foot.
  */
  .home-stage .clients {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin-top: 0;
    color: var(--semantic-fg-on-highlight);
  }
  .home-stage .clients__item,
  .home-stage .clients__svg,
  .home-stage .clients__label {
    color: var(--semantic-fg-on-highlight);
  }
  .clients__label {
    margin: 0 0 var(--primitive-space-sp400);
    text-align: center;
    font: var(--type-label-mono);
    letter-spacing: var(--type-label-mono-tracking);
    text-transform: uppercase;
  }
  /*
    The row runs full-bleed, and the fade starts at the measure, not at the
    screen. --measure-inline is the page padding, and past the max width the
    centred column adds the same gutter the type uses. Outside that the marks
    are gone, so the margin matches the rest of the page.
  */
  .clients__viewport {
    --clients-gutter: max(
      var(--measure-inline),
      calc((100% - var(--primitive-size-max-width)) / 2 + var(--measure-inline))
    );
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent var(--clients-gutter),
      black calc(var(--clients-gutter) + var(--primitive-layout-l48)),
      black calc(100% - var(--clients-gutter) - var(--primitive-layout-l48)),
      transparent calc(100% - var(--clients-gutter))
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent var(--clients-gutter),
      black calc(var(--clients-gutter) + var(--primitive-layout-l48)),
      black calc(100% - var(--clients-gutter) - var(--primitive-layout-l48)),
      transparent calc(100% - var(--clients-gutter))
    );
  }
  .clients__track {
    display: flex;
    width: max-content;
  }
  .clients__list {
    display: flex;
    align-items: center;
    gap: var(--primitive-layout-l64);
    margin: 0;
    /* Start inset keeps the first mark out of the edge fade. The trailing
       space is the gap minus that inset, so the seam between the two lists
       equals the gap between marks. */
    padding: 0 calc(var(--primitive-layout-l64) - var(--primitive-layout-l48)) 0 var(--primitive-layout-l48);
    list-style: none;
  }
  .clients__item {
    display: flex;
    align-items: center;
    flex: none;
    color: var(--semantic-fg-primary);
  }
  /*
    Heights are optical. A thin wide word is taller than a short heavy one,
    so they carry the same weight. Expedia Group is stacked: the symbol is
    about three quarters of the mark and the word sits under it. 56px puts
    that symbol a step above the wordmarks and leaves the word readable.
  */
  .clients__svg {
    display: block;
    height: 24px;
    width: auto;
    color: var(--semantic-fg-primary);
  }
  .clients__svg[data-mark='expedia-group'] { height: 56px; }
  .clients__svg[data-mark='vrbo'] { height: 28px; }
  .clients__svg[data-mark='viaplay'] { height: 26px; }
  .clients__svg[data-mark='sky'] { height: 22px; }
