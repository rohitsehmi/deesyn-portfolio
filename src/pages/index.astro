---
import Base from '../layouts/Base.astro';
import { Nav } from '../components/Nav';
import { Band } from '../components/Band';
import { Footer } from '../components/Footer';
import { CaseStudyTile } from '../components/CaseStudyTile';
import { Parallax } from '../components/Parallax';
import { liveStudies, studiesFor, studyPath, studyCopyBase } from '../data/studies';
import { BRANDS, DEFAULT_BRAND } from '../data/brands';
import { linksFor } from '../data/nav';
import copy from '../copy/home.json';
import { getImage } from 'astro:assets';
import heroSource from '../assets/hero-parallax.png';

const links = linksFor(Astro.url.pathname);

/*
  Rohit's own image, generated to reader rather than licensed or borrowed: an
  abstract composition standing for design systems and product design together,
  which is what the two case studies are. The Aa tile, the ruled card and the
  repeated forms are the design-system half; nothing in it depicts a real
  product, which is what keeps it clear of the "fake screenshot" failure mode.
  It replaces a Revolut marketing asset that was only ever scaffolding to build
  the parallax against.

  The hero is the LCP element, so it is the one image on the site whose weight
  is worth this. It lives in src/assets/, not public/, which is the whole point:
  public/ is copied byte for byte, src/assets/ goes through the build. Astro
  emits WebP at each width and hashes the filenames, so they cache immutably.
  1.5MB of source PNG becomes 38kB at the largest width actually served.

  The list runs past the source's own width on purpose. Astro will not upscale,
  so it silently drops the widths above it — keeping them means a larger image
  starts using them the day it is dropped in, rather than the list quietly
  capping a better source at this one's dimensions.

  Do not pass heroSource.width/height into the markup. That reference is what
  pulls the unoptimised original into dist/; without it Astro prunes it, and
  the image layer is absolutely positioned so intrinsic size reserves nothing.
*/
const hero = await getImage({
  src: heroSource,
  format: 'webp',
  widths: [640, 960, 1280, 1600, 1920, 2560],
  sizes: '100vw'
});

/*
  Tile covers, through the same pipeline. Narrower than the hero because they
  are: the measure caps at 1000 and they sit two-up above 768, so the largest
  one ever renders at is about 480 CSS pixels, 960 on a 2x display.

  `sizes` has to describe that or the browser picks from the srcSet against a
  100vw assumption and downloads the widest candidate for a half-width slot.
*/
/*
  How many tiles each brand actually sees, which only the hero sentence needs.

  The grid used to need it too, and emitted it as `data-count` plus a
  `data-count-<brand>` per brand so that the column count could follow the item
  count. The grid is capped at two columns now and lays out identically whatever
  the number is, so those attributes have no consumer and are gone. See the note
  on .work in the stylesheet below.

  The hero still counts, because it says the number out loud.

  It was written once, for the default brand, and copied, so wise.deesyn.com read
  "Two case studies, for Wise." above three tiles: the placeholder study is Wise
  only and nothing connected the prose to the list. CLAUDE.md had already called
  this shape of bug, that anything derived from how many things a brand sees has
  it waiting.

  So the number is substituted from studiesFor(), never typed. The copy keeps the
  whole sentence in one editable string around a {count} token, which is the
  pattern how-this-was-built.astro already uses for its build-time figures.
*/
const counts = Object.fromEntries(BRANDS.map((b) => [b, studiesFor(b).length])) as Record<
  (typeof BRANDS)[number],
  number
>;
const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];

const heroTitleFor = (brand: (typeof BRANDS)[number]) => {
  const raw: string =
    brand === DEFAULT_BRAND ? copy.heroTitle : (copy.brands as any)[brand].heroTitle;

  /*
    A hardcoded number renders as a plausible sentence and is invisible in review
    — which is exactly how the original survived. Refuse it at build time rather
    than substituting nothing and shipping whichever count was typed.
  */
  if (!raw.includes('{count}')) {
    throw new Error(
      `index: the ${brand} hero title must carry the {count} token rather than a ` +
      `typed number, because each brand is offered a different number of studies. ` +
      `Edit it in src/copy/home.json.`
    );
  }

  const n = counts[brand];

  /*
    The noun is plural in the copy, so one study would render "One case studies".
    Every brand has at least two today and nextStudy() already guards the same
    boundary, so this fails the build with the instruction rather than carrying a
    pluralisation engine for a case that does not exist yet.
  */
  if (n === 1) {
    throw new Error(
      `index: ${brand} is offered one study, and the hero copy reads "case studies". ` +
      `Rewrite that string in src/copy/home.json for the singular.`
    );
  }

  /*
    Capitalised only when the token opens the sentence, which is where all three
    brands have it today. Doing it unconditionally would silently produce "Just
    Two case studies" the first time someone writes a lead-in.
  */
  const word = NUMBER_WORDS[n] ?? String(n);
  const cased = raw.startsWith('{count}') ? word.charAt(0).toUpperCase() + word.slice(1) : word;
  return raw.replace('{count}', cased);
};

/*
  The standfirst counts too, and it was counting the same way the title used to.

  "One on the design system, the other on product design." was written for the
  default brand, which is offered exactly one study per discipline. Wise and
  Healf are offered `scaling-a-system` as well, which is a second design-system
  study, so both hostnames read "One on the design system" above two of them.
  Nothing rendered as broken; the sentence was simply false — the same shape,
  and the same cause, as the "Two case studies" bug directly above.

  So the number is derived here rather than typed, and the guards below refuse
  the sentence shapes it cannot express instead of substituting something
  plausible.

  NAMING THE TWO DISCIPLINES IN CODE is the one uncomfortable part, because the
  values themselves live in src/copy/studies.json and this is therefore a second
  place that has to agree with a first. It is safe only because the guard makes
  a disagreement loud: rename a discipline there and `systems + product` stops
  equalling the total, which fails the build naming both files. That is the same
  arrangement verify-readme.mjs uses, where a pattern that stops matching is
  itself treated as the failure.
*/
const SYSTEMS = 'Design systems';
const PRODUCT = 'Product design';

const splitFor = (brand: (typeof BRANDS)[number]) => {
  const seen = studiesFor(brand);
  return {
    total: seen.length,
    systems: seen.filter((s) => s.discipline === SYSTEMS).length,
    product: seen.filter((s) => s.discipline === PRODUCT).length
  };
};

const heroStandfirstFor = (brand: (typeof BRANDS)[number]) => {
  const raw: string = copy.heroStandfirst;

  /* Same refusal as the title: a typed number is a plausible sentence and is
     invisible in a diff, so it cannot be allowed to ship silently. */
  if (!raw.includes('{systems}')) {
    throw new Error(
      `index: the hero standfirst must carry the {systems} token rather than a ` +
      `typed number, because each brand is offered a different mix of studies. ` +
      `Edit it in src/copy/home.json.`
    );
  }

  const { total, systems, product } = splitFor(brand);

  /* A discipline the sentence does not mention, or one of these constants gone
     stale against studies.json. Either way the sentence no longer describes the
     list, and guessing which half is wrong is not this file's job. */
  if (systems + product !== total) {
    throw new Error(
      `index: ${brand} is offered ${total} studies but only ${systems + product} of ` +
      `them are "${SYSTEMS}" or "${PRODUCT}", so the standfirst does not describe ` +
      `the list. Either a discipline was renamed in src/copy/studies.json — update ` +
      `SYSTEMS/PRODUCT here to match — or a third discipline now exists and the ` +
      `sentence in src/copy/home.json needs rewriting to name it.`
    );
  }

  /* "the other" is singular and asserts exactly one product-design study. Two
     would render "Two on the design system, the other on product design" above
     three tiles, which is this bug again one discipline across. Fails with the
     instruction rather than carrying a pluralisation engine for a case that does
     not exist — the same call as the singular guard on the title. */
  if (product !== 1) {
    throw new Error(
      `index: ${brand} is offered ${product} product-design studies, and the hero ` +
      `standfirst says "the other", which asserts exactly one. Rewrite that string ` +
      `in src/copy/home.json so it counts both disciplines.`
    );
  }

  if (systems < 1) {
    throw new Error(
      `index: ${brand} is offered no design-system studies, and the hero standfirst ` +
      `names one. Rewrite that string in src/copy/home.json.`
    );
  }

  const word = NUMBER_WORDS[systems] ?? String(systems);
  const cased = raw.startsWith('{systems}') ? word.charAt(0).toUpperCase() + word.slice(1) : word;
  return raw.replace('{systems}', cased);
};

/*
  Brands reading identically share ONE span, via the whitespace-separated list
  `data-brand-only` has matched with ~= since 2026-08-17.

  The title renders one span per brand because all three differ — each names its
  own company. These do not: Wise and Healf are offered the same mix, so writing
  one span each would put the identical sentence in the raw HTML twice. That is
  the audience the space separator on the title was added for, an agent fetching
  the page and never running the stylesheet, and a duplicate paragraph reads as
  a stutter to exactly that reader.
*/
const standfirstsByBrand = BRANDS.reduce((acc, brand) => {
  const sentence = heroStandfirstFor(brand);
  acc.set(sentence, [...(acc.get(sentence) ?? []), brand]);
  return acc;
}, new Map<string, string[]>());

const COVER_SIZES = '(min-width: 1024px) 480px, (min-width: 768px) 45vw, calc(100vw - 40px)';
const covers = new Map(
  await Promise.all(
    liveStudies.filter((s) => s.cover).map(async (s) => [
      s.slug,
      await getImage({ src: s.cover!.src, format: 'webp', widths: [480, 720, 960, 1280], sizes: COVER_SIZES })
    ] as const)
  )
);
---
<Base title="Rohit Sehmi · Product Design" pageEnd="sunken">
  {/*
    Sits over the hero rather than in a band of its own. `overBand` gives it the
    hero's foreground while it is transparent, because it is outside the band
    stack and would otherwise render dark text on a dark image. It drops back to
    the page's own foreground the moment it takes bg/canvas.
  */}
  <Nav client:load sticky onMedia="light" links={links} />

  <main id="main">
    {/*
      The hero is content-led and does not count toward the band alternation,
      per the hero note in the banding spec. It carries data-on-media rather
      than a band role: bands are relative and flip with the theme, and a
      photograph does not.

      tone="light" because this image is pale, which turns off the scrim. The
      alternative was measured and rejected: white text over it needs the full
      70% black scrim to clear AA — 60% fails the standfirst at 3.93:1 — and at
      70% the image reads as a grey wash with none of the quality it was chosen
      for. Dark text on the same image, unscrimmed, is 9.48:1.

      Re-measure with `node design/measure-media-contrast.mjs` if the image
      changes. Without a scrim the contrast comes from the composition, so it is
      a property of this file rather than of the component.

      objectPosition is left, and on a phone that is the whole ballgame: cover
      crops this 1.87:1 image to about a third of its width at 390px. Centred,
      that third is the busy middle and 31% of glyph pixels fail. Every
      alternative was measured against this image and lost — 20% center leaves
      0.1% failing with the blue arc running straight through "product work",
      and the white-scrim variants that pass do so by washing the picture out.
      Left is nearly empty wall on a phone, which is the honest cost: this is a
      1.87:1 composition with its subject on the right, and no portrait crop of
      it can show the subject and carry the type at the same time. Fixing that
      properly means a second, taller crop of the image, not a different value
      here.
    */}
    <Parallax
      src={hero.src}
      srcSet={hero.srcSet.attribute}
      sizes="100vw"
      tone="light"
      objectPosition="left center"
      alt="An abstract still life in cream, off-white and deep blue: a large disc behind a frosted glass panel, a tile lettered Aa, a card of ruled placeholder lines, a sphere and a ribbed panel, arranged on pale steps with a thin blue line curving through them."
      priority
      client:visible
      range="exit"
      drift="140px"
    >
      {/*
        One h1 with one span per brand, not one h1 per brand. Every version
        ships because the build is prerendered and one deployment answers every
        hostname; the hidden ones are display:none, so they leave the
        accessibility tree entirely and the page still has exactly one heading
        with one name. See base.css for how [data-brand] chooses.

        Driven off BRANDS rather than written out, because the hardcoded version
        silently dropped a brand: the copy for a third one was added and the
        markup was not, so that hostname rendered an empty h1 — a heading with
        no name at all, which is worse than the wrong name.

        NOT browser-editable, and deliberately so — same rule as the facts block
        on how-this-was-built. What renders here has had its {count} substituted,
        so blurring an edit would write "Two case studies" back into the JSON,
        bake today's number into the copy and stop the page recomputing it. That
        is the bug this markup was just fixed for, and a data-copy attribute
        would hand it straight back.

        Edit it through the markdown round trip instead — `npm run copy:export`
        works on the JSON, so the token survives. Keep the braces.
      */}
      {/*
        The spans are joined by a space, and it is not cosmetic.

        One prerendered build serves three brands, so all three headlines ship
        and CSS hides the two that do not apply. A screen reader is unaffected —
        `display: none` removes those nodes from the accessibility tree, which
        is the whole reason the rules hide rather than clip. But anything
        reading the raw HTML sees every span, and with no separator between them
        the h1's text content came out fused:

          "Two case studies, for Revolut.Three case studies, for Wise.Three…"

        That matters here more than it would elsewhere. This URL travels one
        way — pasted to a named person — and increasingly that means pasted into
        an agent, which fetches the HTML and never runs the stylesheet. A single
        space turns one garbled run-on into three complete sentences, each
        naming the brand it belongs to.

        A space, and not the tidier-looking options. `hidden` with a CSS
        un-hide would mean declaring a `display` value on the version that
        shows, which is the exact shape of the `display: revert` bug that
        shipped misaligned receipts on the Wise host. `aria-hidden` cannot work
        at all: the HTML is static and cannot know which brand will render it.
      */}
      <h1 class="home-hero__title">
        {BRANDS.map((brand, i) => (
          <>
            {i > 0 && ' '}
            <span data-brand-only={brand}>{heroTitleFor(brand)}</span>
          </>
        ))}
      </h1>
      {/*
        NOT browser-editable either, and for the reason the title is not: what
        renders has had its {systems} token substituted, so blurring an edit
        would write "Two on the design system" back into the JSON and stop the
        page recomputing it — handing back the exact bug this markup fixes. Edit
        it through `npm run copy:export`, which works on the JSON. Keep the
        braces.

        Spans joined by a space, same as the title above: every version ships and
        CSS hides the ones that do not apply, so anything reading the raw HTML
        sees them all and needs a separator to read them as sentences.
      */}
      <p class="home-hero__standfirst">
        {[...standfirstsByBrand].map(([sentence, brands], i) => (
          <>
            {i > 0 && ' '}
            <span data-brand-only={brands.join(' ')}>{sentence}</span>
          </>
        ))}
      </p>
    </Parallax>

    {/* base, because the hero above resolves dark. */}
    <Band role="base" scale="default">
      {/*
        No count on the list, deliberately, and this is where one used to be.

        The grid picked its columns from how many tiles there were, so the count
        had to be emitted once per brand: each brand sees a different number, and
        `display: none` removes a grid ITEM but cannot remove a TRACK, so a tile
        hidden from a brand still left an empty column on that brand's hostname.

        Capping the grid at two columns removes the dependency rather than
        guarding it. Nothing here needs to know how many tiles this brand sees,
        so nothing can get that number wrong.
      */}
      <ul class="work">
        {/*
          Every live study across every brand, with the brand-specific ones
          marked so CSS can drop them. It has to be this way round: one build
          answers every hostname, so the tile a brand does not get still ships
          in the HTML and is hidden rather than never rendered.

          data-brand-only sits on the <li> rather than on the tile, so the grid
          item goes with it. Hiding the tile alone would leave an empty cell,
          which on a two-column grid is not a smaller list — it is a hole.
        */}
        {liveStudies.map((s) => (
          <li data-brand-only={s.brands?.join(' ')}>
            <CaseStudyTile
              title={s.title}
              summary={s.summary}
              discipline={s.discipline}
              href={studyPath(s)}
              variant="card"
              copyBase={studyCopyBase(s)}
              image={{
                src: covers.get(s.slug)?.src,
                srcSet: covers.get(s.slug)?.srcSet.attribute,
                sizes: COVER_SIZES,
                alt: s.cover?.alt ?? `Cover image for ${s.title}`
              }}
            />
          </li>
        ))}
      </ul>
    </Band>
  </main>

  {/* sunken: the work band above is base. */}
  <Band role="sunken" scale="compact" bleed>
    <Footer scale="compact" currentPath={Astro.url.pathname} />
  </Band>
</Base>

<style is:global>
  /* Type steps between styles on the scale. No clamps, no raw sizes. */
  .home-hero__title {
    margin: 0 0 var(--primitive-space-sp600);
    max-width: 16ch;
    font: var(--type-display-s);
    letter-spacing: var(--type-display-s-tracking);
    color: var(--semantic-fg-primary);
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .home-hero__title { font: var(--type-display-m); letter-spacing: var(--type-display-m-tracking); }
  }
  @media (min-width: 1024px) {
    .home-hero__title { font: var(--type-display-l); letter-spacing: var(--type-display-l-tracking); }
  }

  /*
    32ch, not the usual 52ch, and fg/primary rather than fg/secondary. Both are
    forced by the unscrimmed hero and both were measured, glyph by glyph:

    - fg/secondary is #717173 in this tonality, a grey built for 4.87:1 on pure
      white. The image's wall is not pure white, so it fails AA on 100% of its
      glyph pixels at every width tested. There is no width that rescues it.
    - At 52ch the line runs off the plain wall into the frosted square and the
      navy behind it: 12.4% of glyph pixels fail even at fg/primary. 40ch still
      fails 4.5%. 32ch is the first clean width, at 8.92:1.

    Hierarchy comes from size here instead of colour, which is the trade a
    scrimless hero makes.
  */
  .home-hero__standfirst {
    margin: 0;
    max-width: 32ch;
    font: var(--type-body-l);
    letter-spacing: var(--type-body-l-tracking);
    color: var(--semantic-fg-primary);
    text-wrap: pretty;
  }
  @media (min-width: 768px) {
    .home-hero__standfirst { font: var(--type-body-xl); letter-spacing: var(--type-body-xl-tracking); }
  }

  /*
    Two columns at most, whatever the count, so a third tile drops underneath
    the first two rather than squeezing the row to thirds.

    This replaced a set of rules that picked the column count from how many
    tiles the brand could see, which is why `data-count` and a `data-count-<brand>`
    per brand used to be emitted here. Three across was tried and read as
    cramped: a case-study tile carries a cover, a title and a summary, and at a
    third of the measure the summary breaks to five or six lines while the cover
    loses the detail that makes it worth showing.

    Capping at two also deletes a whole class of bug rather than fixing another
    instance of it. The count rules had to be written once per brand and guarded
    with :root:not(...) so that two counts could not match at once, because
    `display: none` removes a grid item but cannot remove a track, so a tile
    hidden from one brand still left a column behind on that brand's hostname.
    None of that reasoning is needed once the track count stops depending on how
    many things a brand sees. A ragged last row is the correct trade: it is what
    a list of three looks like, and it costs nothing to read.
  */
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--primitive-layout-l64);
  }
  @media (min-width: 768px) {
    .work {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--primitive-layout-l48);
    }
  }
</style>
