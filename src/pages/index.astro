---
import Base from '../layouts/Base.astro';
import { Nav } from '../components/Nav';
import { Band } from '../components/Band';
import { Footer } from '../components/Footer';
import { CaseStudyTile } from '../components/CaseStudyTile';
import { studies, studyPath } from '../data/studies';
import { linksFor } from '../data/nav';

const links = linksFor(Astro.url.pathname);
---
<Base title="Rohit Sehmi · Product Design">
  {/* Not in a band: a base nav above a base hero stacks padding at a seam with
      no colour step, which rule 1 forbids. Nav is transparent at state=top and
      inherits the band beneath it. */}
  <Nav client:load sticky links={links} />

  <main id="main">
    <Band role="base" scale="feature">
      <h1 class="home-hero__title">Product design, end to end.</h1>
      <p class="home-hero__standfirst">
        Two case studies. One on the design system work, one on the product work.
      </p>
    </Band>

    {/* default, not feature: the hero above is already feature, and rule 7
        forbids two adjacent bands at the same weight. */}
    <Band role="sunken" scale="default">
      <ul class="work" data-count={studies.length}>
        {studies.map((s) => (
          <li>
            <CaseStudyTile
              title={s.title}
              summary={s.summary}
              discipline={s.discipline}
              href={studyPath(s)}
              image={{ alt: `Cover image for ${s.title}` }}
            />
          </li>
        ))}
      </ul>
    </Band>
  </main>

  <Band role="base" scale="compact">
    <Footer scale="compact" />
  </Band>
</Base>

<style is:global>
  /* Type steps between styles on the scale. No clamps, no raw sizes. */
  .home-hero__title {
    margin: 0 0 var(--primitive-space-sp600);
    max-width: 16ch;
    font: var(--type-display-s);
    letter-spacing: var(--type-display-s-tracking);
    color: var(--semantic-fg-primary);
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .home-hero__title { font: var(--type-display-m); letter-spacing: var(--type-display-m-tracking); }
  }
  @media (min-width: 1024px) {
    .home-hero__title { font: var(--type-display-l); letter-spacing: var(--type-display-l-tracking); }
  }

  .home-hero__standfirst {
    margin: 0;
    max-width: 60ch;
    font: var(--type-body-l);
    letter-spacing: var(--type-body-l-tracking);
    color: var(--semantic-fg-secondary);
    text-wrap: pretty;
  }
  @media (min-width: 768px) {
    .home-hero__standfirst { font: var(--type-body-xl); letter-spacing: var(--type-body-xl-tracking); }
  }

  /* Columns follow the item count, so the last row is never ragged. Three
     studies in a two-column grid would leave a hole beside the third, which is
     the same failure as pasting a blank tile. */
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--primitive-layout-l64);
  }
  @media (min-width: 768px) {
    .work[data-count='2'], .work[data-count='4'] {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--primitive-layout-l48);
    }
  }
  /* Three stays single-column until there is room for all three side by side. */
  @media (min-width: 1024px) {
    .work[data-count='3'] {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--primitive-layout-l48);
    }
  }
</style>
