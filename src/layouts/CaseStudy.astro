---
import Base from './Base.astro';
import { Nav } from '../components/Nav';
import { Band } from '../components/Band';
import { Footer } from '../components/Footer';
import { CaseStudyTile } from '../components/CaseStudyTile';
import { studies, nextStudyByBrand, studyPath, studyCopyBase } from '../data/studies';
import { readingTime } from '../data/reading-time';
import { linksFor } from '../data/nav';

/**
 * The case-study shell.
 *
 * The section order is the order these questions get asked, and it states
 * it: problem and insight, then process, then interface, then impact, then
 * hindsight. It is deliberately not the structure of the old Expedia page,
 * which was organised around what the system contained and therefore had
 * nowhere to put rejected explorations, testing trade-offs, or hindsight.
 *
 * Slots are named rather than a single default slot so a study cannot quietly
 * ship without its heaviest sections. An empty slot renders nothing and is
 * visible as a gap in review.
 *
 * Band rhythm: one inverse band, on impact. The adjacency rules cap inverse at
 * two per page (docs/banding-system.md, rule 4), so a second is available and
 * deliberately unspent until the content says where it earns its place.
 */
interface Props {
  title: string;
  standfirst: string;
  description?: string;
  /** Which study this is, so the layout can offer the other one at the foot. */
  slug: string;
  /**
   * `<file>:<path>` into src/copy for the heading and standfirst, making them
   * editable in the browser under `npm run dev`. Dev tooling only; they render
   * as plain data attributes and do nothing in a build.
   */
  titleCopyRef?: string;
  standfirstCopyRef?: string;
}
const { title, standfirst, description, slug, titleCopyRef, standfirstCopyRef } = Astro.props;

const links = linksFor(Astro.url.pathname);

/*
  Offered by the layout rather than repeated on every page, and read from the
  one list in src/data/studies.ts so it cannot disagree with the index.

  One answer per brand, because a brand can be offered a different set of
  studies and the foot of a page must never point at one this hostname does not
  show. All of them render and CSS picks, the same as everywhere else — the
  brand is a runtime fact and this is a prerendered page.
*/
const nexts = nextStudyByBrand(slug);

/*
  When every brand lands on the same study there is nothing to choose between,
  so it renders once with no gate. That is the case on every page today; the
  branch below is what carries a brand-specific study.

  With two brands, a group is either all of them or one of them, so a single
  data-brand-only value always suffices. A third brand would break that — two
  brands sharing a next that a third does not is not expressible in one
  attribute — and the fix then is a value per brand rather than a cleverer
  selector.
*/
const sharedNext = new Set(nexts.map((n) => n.study?.slug)).size === 1 ? nexts[0].study : undefined;

/*
  Rule 1 says no two consecutive bands share a fill, so the footer's role
  depends on whether the next-study band is above it.

  Which means every brand has to agree about whether that band exists. A band
  is one element in one prerendered document; `data-brand-only` can hide what is
  inside it, but the footer's fill is decided here, at build time, once for
  every hostname. `nextStudy` is written so this cannot happen — a live study
  outside a brand's rotation falls back to that brand's first study rather than
  returning nothing — and this is the assertion that says so out loud instead of
  leaving a silent adjacency bug for the band linter to find on one host only.
*/
const withNext = nexts.filter((n) => n.study).length;
if (withNext !== 0 && withNext !== nexts.length) {
  throw new Error(
    `${slug}: brands disagree about whether a next study exists ` +
      `(${nexts.map((n) => `${n.brand}=${n.study?.slug ?? 'none'}`).join(', ')}). ` +
      `The next-study band is one element for every brand, so its presence cannot vary by hostname.`
  );
}
const footerRole = withNext ? 'base' : 'sunken';

/**
 * Measured off this study's copy file — see src/data/reading-time.ts. It is
 * here rather than on each page for the same reason `next` is: one arrangement
 * cannot disagree with itself, and a per-page number would be a number someone
 * has to remember to update.
 */
const reading = readingTime(slug);

/* Marks the page as an Article in structured data, and carries the discipline
   through as its section. Read from the one studies list rather than passed in,
   for the same reason `next` is: two places to state it is two places to
   disagree. */
const discipline = studies.find((s) => s.slug === slug)?.discipline;
---

<Base
  title={`${title} · Rohit Sehmi`}
  description={description ?? standfirst}
  pageEnd={footerRole}
  article={{ section: discipline }}
  socialTitle={title}
>
  {/*
    Nav sits in flow, not in a band. `state=top` is transparent and inherits the
    foreground beneath it, and the component carries its own height and measure.
    Giving it a `base` band above a `base` hero would stack two lots of padding
    at a seam with no colour step, which is exactly what rule 1 forbids.
  */}
  <Nav client:load sticky links={links} />

  <main id="main">
    {/* Hero. Two text elements and no CTA: the reader arrived here on purpose. */}
    <Band role="base" scale="feature">
      <div class="cs-hero">
        <h1 class="cs-hero__title" data-copy={titleCopyRef}>{title}</h1>
        {/*
          Standfirst and reading time are one group so the hero's sp800 rhythm
          stays between groups, not inside one. The meta line is metadata about
          the standfirst above it and belongs closer to it than to the
          contribution list below.
        */}
        <div class="cs-hero__lede">
          <p class="cs-hero__standfirst" data-copy={standfirstCopyRef}>{standfirst}</p>
          {/*
            Deliberately not browser-editable and carrying no data-copy: the
            string is computed from the copy, so writing it back would bake
            today's word count into the copy and stop the page recomputing it.
            Same trap the facts block on /how-this-was-built avoids.

            <time> because this is a duration and datetime takes one, which
            makes the estimate machine-readable rather than just a string that
            happens to end in "read".
          */}
          {reading && (
            <p class="cs-hero__meta">
              <time datetime={`PT${reading.minutes}M`}>{reading.label}</time>
            </p>
          )}
        </div>
        <slot name="contribution" />
      </div>
    </Band>

    <Band role="sunken" scale="default">
      <slot name="problem" />
    </Band>

    {/* The longest band on the page, and the one carrying the most weight. */}
    <Band role="base" scale="feature">
      <slot name="process" />
    </Band>

    <Band role="sunken" scale="default">
      <slot name="interface" />
    </Band>

    <Band role="inverse" scale="feature">
      {/*
        The read-depth marker. Impact rather than hindsight: hindsight is the
        last block before the footer, so anyone scrolling to the bottom for any
        reason passes through it and would report as a full read.
      */}
      <div data-read-depth={slug}><slot name="impact" /></div>
    </Band>

    {/* Rule 5: come out of inverse into base, never into sunken. */}
    <Band role="base" scale="default">
      <slot name="hindsight" />
    </Band>

    {/* Omitted entirely when there is nothing to offer. An empty band is not
        neutral: it renders as a stripe of padding that reads as a layout bug. */}
    {withNext > 0 && (
      <Band role="sunken" scale="default">
        <p class="cs-next__label">Next</p>
        {/*
          One band, with the tile inside it chosen by brand — not one band per
          brand. Two bands would be two SUNKEN bands next to each other in the
          document, which breaks adjacency rule 1 for the band linter and for
          anyone reading the HTML, and hiding one with CSS does not change what
          is written down. The label is shared because it says the same thing
          whichever tile follows it.
        */}
        {sharedNext ? (
          <CaseStudyTile
            title={sharedNext.title}
            summary={sharedNext.summary}
            discipline={sharedNext.discipline}
            copyBase={studyCopyBase(sharedNext)}
            href={studyPath(sharedNext)}
          />
        ) : (
          nexts.map(({ brand, study }) => study && (
            <div data-brand-only={brand}>
              <CaseStudyTile
                title={study.title}
                summary={study.summary}
                discipline={study.discipline}
                copyBase={studyCopyBase(study)}
                href={studyPath(study)}
              />
            </div>
          ))
        )}
      </Band>
    )}
  </main>

  <Band role={footerRole} scale="compact" bleed>
    <Footer scale="compact" currentPath={Astro.url.pathname} />
  </Band>
</Base>

<style is:global>
  .cs-hero {
    display: flex;
    flex-direction: column;
    gap: var(--primitive-space-sp800);
  }
  /* Each element caps its own measure. The container stays full width so the
     contribution block below can use the band's grid. */
  /* Three steps up the display scale rather than one clamp. Every size the
     page renders is a Figma text style. */
  .cs-hero__title {
    margin: 0;
    max-width: 18ch;
    font: var(--type-display-s);
    letter-spacing: var(--type-display-s-tracking);
    color: var(--semantic-fg-primary);
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .cs-hero__title { font: var(--type-display-m); letter-spacing: var(--type-display-m-tracking); }
  }
  @media (min-width: 1024px) {
    .cs-hero__title { font: var(--type-display-l); letter-spacing: var(--type-display-l-tracking); }
  }

  /*
    The vertical rhythm between the blocks inside one section.

    Only SectionHeading owned the space after it, so every other pair — Metrics
    against the paragraph under it, a Media against the prose either side of it —
    stacked at zero and read as one run-on block. Fixed here rather than as a
    margin on each component, because a trailing margin on the last block in a
    section adds space the band has already paid for, and because this is a
    property of the arrangement, which is what this file is for.

    Three steps, each a real one: 20px between paragraphs (.prose), 40px from a
    heading to the content it introduces (.section-heading), 64px between two
    blocks that are peers. 48px was the alternative and says nothing the 40 does
    not — if block-to-block is meant to read as the bigger break, it has to be
    visibly bigger.

    `> * + *` and not a gap, so a section with one block is unaffected.
  */
  /*
    The class is doubled to raise specificity, not by accident. Components reset
    their own root margin — `.explorations` is `margin: 0` — and a single class
    plus two universals ties with a single class, so it came down to bundle
    order and the component won. That only ever showed on
    machine-readable-components, the one section where Explorations does not
    follow a heading and so was not already being zeroed on purpose.
  */
  .cs-section.cs-section > * + * { margin-block-start: var(--primitive-layout-l64); }
  /*
    A heading already owns the space to the thing it introduces, and adjacent
    margins collapse to the larger of the two — so without this the heading's
    40px would silently become 64px and the two steps would be one. Zeroing the
    start margin here hands the gap back to .section-heading, which is where the
    40px is stated.
  */
  .cs-section.cs-section > .section-heading + * { margin-block-start: 0; }

  .cs-next__label {
    margin: 0 0 var(--primitive-space-sp600);
    font: var(--type-emphasis-2);
    letter-spacing: var(--type-emphasis-2-tracking);
    color: var(--semantic-fg-secondary);
  }

  .cs-hero__standfirst {
    margin: 0;
    max-width: 60ch;
    font: var(--type-body-l);
    letter-spacing: var(--type-body-l-tracking);
    color: var(--semantic-fg-secondary);
    text-wrap: pretty;
  }
  @media (min-width: 768px) {
    .cs-hero__standfirst { font: var(--type-body-xl); letter-spacing: var(--type-body-xl-tracking); }
  }

  /* The standfirst and its reading time, held closer to each other than the
     hero's sp800 holds the blocks apart. */
  .cs-hero__lede {
    display: flex;
    flex-direction: column;
    gap: var(--primitive-space-sp500);
  }

  /*
    Quiet on purpose. This is an aid to a decision the reader makes before they
    start, not a claim about the work — at the standfirst's weight it would
    compete with the first sentence of the study, which is the one thing on the
    page that has to land.

    fg/secondary, which is 4.87:1 and legible at 14px. Not fg/tertiary: that is
    1.65:1 on white and fails AA for body text, and this is text.

    Regular weight, not emphasis. At 600 it sat directly above `Role` — also
    600, one size up — and read as a fourth row of the contribution list rather
    than as metadata about the study. 16px of space above it and 24px below was
    not enough of a difference to say otherwise; dropping the weight is.
  */
  .cs-hero__meta {
    margin: 0;
    font: var(--type-body-2);
    letter-spacing: var(--type-body-2-tracking);
    color: var(--semantic-fg-secondary);
  }
</style>

<script>
  import { trackReadDepth } from '../components/analytics';
  import { tickNumbers } from '../components/number-ticker';
  import { initCarousels } from '../components/carousel-controls';
  trackReadDepth();
  // No-ops on a study with no gallery in it: it queries for [data-carousel]
  // and finds nothing. Cheaper than making each page remember to opt in.
  initCarousels();
  // Case studies only. These are the only pages with an impact band, and the
  // only numbers on the site worth drawing the eye to.
  tickNumbers();
</script>
