---
import '../styles/tokens.css';
import '../styles/base.css';
import { ThemeToggle } from '../components/ThemeToggle';
import Analytics from '@vercel/analytics/astro';
interface Props {
  title: string;
  description?: string;
  /**
   * The band the page ends on. Painted onto <html> so a rubber-band scroll
   * past the bottom continues that band rather than cutting to the canvas.
   */
  pageEnd?: 'base' | 'sunken';
}
const { title, description = 'Product design work by Rohit Sehmi.', pageEnd = 'base' } = Astro.props;

/*
  Built from `site` rather than from the request, so a page served on the
  .vercel.app deployment URL still points at the real one. Astro serves
  directory-style URLs, so the pathname already carries its trailing slash and
  is left exactly as-is -- normalising it here would disagree with the address
  bar and with every internal link.
*/
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://www.deesyn.com').href;
---
<!doctype html>
<html lang="en" data-page-end={pageEnd}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/*
      Unlisted, not private. Belt and braces with public/robots.txt and the
      X-Robots-Tag header in vercel.json: robots.txt asks a crawler not to
      fetch, this tells one that did fetch not to index, and the header covers
      what a meta tag cannot reach — the CV PDF in public/.
    */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonicalUrl} />
    {/*
      Rohit's own mark, generated from the same path data the Logo component
      renders — see design/build-favicon.mjs. The SVG carries its own
      prefers-color-scheme rule, which matters more here than on the page: a
      favicon sits on the browser's tab strip rather than on the site, so a dark
      mark would vanish into a dark tab. The PNGs are the fallback and cannot
      flip, so they take the light fill.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/*
      Applies a remembered theme before the first paint. It has to be inline
      and blocking: a module script, or anything React does after hydration,
      runs after the page has already painted in the system theme, so the page
      would visibly flip. Deliberately tiny for the same reason.
    */}
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <ThemeToggle client:load />
    {/*
      Cookieless, so no consent banner — which is the whole reason it is this
      and not GA4. A cookie dialog is the first thing a reader would interact
      with on a site arguing about interface judgement.

      It no-ops until Web Analytics is enabled on the Vercel project, and logs
      to the console instead of sending in development.
    */}
    <Analytics />
    <style is:global>
      .skip {
        position: absolute; left: -9999px;
        background: var(--semantic-bg-canvas); color: var(--semantic-fg-primary);
        padding: 12px 20px; border-radius: var(--primitive-radius-r8);
      }
      .skip:focus { left: 16px; top: 16px; z-index: 10; }
    </style>
  </body>
</html>
