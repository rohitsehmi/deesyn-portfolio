---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { ThemeToggle } from '../components/ThemeToggle';
import Analytics from '@vercel/analytics/astro';
interface Props {
  title: string;
  description?: string;
  /**
   * The band the page ends on. Painted onto <html> so a rubber-band scroll
   * past the bottom continues that band rather than cutting to the canvas.
   */
  pageEnd?: 'base' | 'sunken';
  /**
   * Set by CaseStudy.astro. A case study is an article with an author and a
   * subject; every other page here is part of the site itself, and claiming
   * otherwise in structured data is the kind of overreach schema.org invites.
   */
  article?: { published?: string; section?: string };
  /**
   * The page's own name, without the " · Rohit Sehmi" suffix that <title>
   * carries. og:site_name already says whose site this is, so repeating it in
   * og:title reads as stutter on the card, and an Article headline that ends in
   * its own author's name is simply wrong.
   */
  socialTitle?: string;
  /**
   * www.deesyn.com is indexable. Pass `noindex, follow` for a page whose
   * copy disagrees with the rest of the site. Partner hostnames, preview
   * deploys and the CV PDF are kept out by X-Robots-Tag in vercel.json,
   * because this HTML is the same file on every host and a meta tag
   * cannot cover a PDF.
   */
  robots?: string;
}
const {
  title,
  description = 'Product design work by Rohit Sehmi.',
  pageEnd = 'base',
  article,
  socialTitle,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1'
} = Astro.props;
const cardTitle = socialTitle ?? title;

/*
  Built from `site` rather than from the request, so a page served on the
  .vercel.app deployment URL still points at the real one. Astro serves
  directory-style URLs, so the pathname already carries its trailing slash and
  is left exactly as-is -- normalising it here would disagree with the address
  bar and with every internal link.
*/
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://www.deesyn.com').href;

const siteOrigin = (Astro.site ?? new URL('https://www.deesyn.com')).origin;
/* Absolute, because og:image is one of the few places a relative URL is simply
   invalid rather than merely resolved differently. */
const ogImage = new URL('/og.png', siteOrigin).href;
const ogType = article ? 'article' : 'website';

const person = {
  '@type': 'Person',
  name: 'Rohit Sehmi',
  url: `${siteOrigin}/`,
  jobTitle: 'Product and design systems designer',
  email: 'rohit.sehmi@gmail.com',
  sameAs: ['https://www.linkedin.com/in/rohitsehmi'],
  address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' }
};

const structuredData = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: cardTitle,
      description,
      url: canonicalUrl,
      image: ogImage,
      author: person,
      publisher: person,
      inLanguage: 'en-GB',
      ...(article.published ? { datePublished: article.published } : {}),
      ...(article.section ? { articleSection: article.section } : {})
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Rohit Sehmi',
      alternateName: 'Deesyn',
      description,
      url: `${siteOrigin}/`,
      inLanguage: 'en-GB',
      author: person
    };
---
<!doctype html>
<html lang="en" data-page-end={pageEnd}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/*
      www.deesyn.com is the address to index. robots.txt allows the crawl
      and names the sitemap. Partner hostnames, preview deploys and
      /Ro_CV.pdf stay noindex via X-Robots-Tag, which is the only signal
      that can differ by host or cover a PDF. A page passes `robots` when
      it should stay out.
    */}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={`${siteOrigin}/sitemap.xml`} />
    {/*
      The unfurl card, for the one way this URL actually travels: pasted into a
      message to a named person. Without these, Slack, LinkedIn, iMessage and
      WhatsApp render the bare address, which is the least persuasive thing a
      link to a portfolio can look like.

      og:image is an absolute URL because the spec requires it, and generated
      from the brand lockup rather than drawn — see design/build-og-image.mjs.
    */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Rohit Sehmi" />
    <meta property="og:title" content={cardTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/*
      Brand-neutral, and it has to be. Meta tags are read out of the HTML by a
      crawler that never runs the script deciding which brand a hostname shows,
      so anything naming a company would be wrong on every other hostname.

      The card image is generated per brand and vercel.json rewrites /og.png
      per host, and an unfurler STILL gets the default one. og:image must be
      absolute per the OpenGraph spec, this builds it from `site`, and one
      prerendered build has one origin — so every host's HTML names
      www.deesyn.com, the crawler asks www, and www's arm is the default. The
      rewrite is correct and nothing reaches it. Verified on all four hosts by
      reading this tag out of production and fetching exactly what it names.

      IT STOPPED BEING A CROSS-BRAND LEAK ON 2026-08-26 without being fixed,
      which is worth separating from being fixed. The default card was
      Revolut's lockup, so a link pasted from the Wise hostname unfurled with
      another company's mark on it. The default card is now the bare Ro disc,
      so the same broken path now shows a company-neutral mark instead of the
      wrong company's. Still the wrong card, and no longer an embarrassing one.
      The real fix is unchanged and is a build per brand, since that is what
      gives each one its own `site`.

      Not fixable here, and not a bodge worth attempting: an absolute URL pins
      the host before any rewrite is consulted. As of 2026-10-19 www is
      crawled, so an unfurler does fetch this tag, and the card it gets is
      the apex mark. Partner hostnames and preview deploys stay noindex.
      A build per brand would give each host its own card, since each build
      would set its own `site`. design/verify-vercel-config.mjs prints the
      pin on every run so it cannot quietly become an assumption. See
      CLAUDE.md § Social and structured data.
    */}
    <meta property="og:image:alt" content="Rohit Sehmi" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cardTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/*
      Structured data, for the readers that parse rather than render — which now
      includes the language models people ask about candidates. It says the same
      things the page says, in the form a machine can take: who this is, and for
      a case study, that the page is an article with an author and a subject.

      Deliberately modest. Schema.org rewards inventing properties you cannot
      support, and every value below is already on the page in words.
    */}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {/*
      Rohit's own mark, generated from the same path data the Logo component
      renders — see design/build-favicon.mjs. The PNG is listed first and the
      tile is light, because a navy disc disappears on a dark tab and a browser
      that refuses the SVG then shows nothing at all.
    */}
    <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    {/*
      Applies a remembered theme before the first paint. It has to be inline
      and blocking: a module script, or anything React does after hydration,
      runs after the page has already painted in the system theme, so the page
      would visibly flip. Deliberately tiny for the same reason.
    */}
    {/*
      Theme, before the first paint. Partner hostnames were retired on
      2026-10-19, so this no longer sets [data-brand]. The default is the
      absence of the attribute.
    */}
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        /*
          Partner hostnames were retired on 2026-10-19. Nothing here sets
          [data-brand]. The default is the absence of the attribute.
        */
        var b = document.documentElement.dataset.brand || 'deesyn';
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('[data-brand-only]').forEach(function (el) {
            var tokens = ' ' + el.getAttribute('data-brand-only') + ' ';
            if (tokens.indexOf(' ' + b + ' ') >= 0) return;
            var prev = el.previousSibling;
            var next = el.nextSibling;
            if (prev && prev.nodeType === 3 && !/\S/.test(prev.textContent)) prev.remove();
            if (next && next.nodeType === 3 && !/\S/.test(next.textContent)) next.remove();
            el.remove();
          });
        });
      } catch (e) {}
    </script>
    {/*
      Preload the DISPLAY face's latin subset and nothing else.

      This replaced a `preconnect` to fonts.googleapis.com that had sat here
      pointing at a host nothing ever requested from — the site named two
      typefaces in 23 text styles and loaded neither, so every visitor read it
      in system-ui. Fonts are self-hosted now: see design/build-fonts.mjs for
      why not Google, and design/verify-fonts.mjs for what stops it regressing.

      One file, not four. Manrope is the face the hero and every heading
      resolve to, so it is what a reader sees first and the only one worth
      spending a preload on. DM Sans is the body and UI face, discovered from
      the stylesheet.
      The latin-ext subsets are deliberately NOT preloaded: unicode-range means
      most readers never fetch them at all, and preloading a file the browser
      then declines to use is a wasted round trip and a console warning.

      crossorigin is REQUIRED even same-origin: fonts are fetched in CORS mode,
      and a preload without it is a second, separate fetch rather than a
      warm cache entry — the classic way a preload makes a page slower.
    */}
    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body data-route={Astro.routePattern}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <ThemeToggle client:load />
    {/*
      Cookieless, so no consent banner — which is the whole reason it is this
      and not GA4. A cookie dialog is the first thing a reader would interact
      with on a site arguing about interface judgement.

      It no-ops until Web Analytics is enabled on the Vercel project, and logs
      to the console instead of sending in development.
    */}
    <Analytics />
    {/*
      Field Core Web Vitals, also cookieless. Speed Insights was already enabled
      on the Vercel project, but nothing on the site rendered it, so it reported
      "no data" -- which reads exactly like no traffic, and this site does not
      have much. An unwired integration that looks like a quiet one is worse
      than an absent one.

      Worth the second script for one reason: the hero is the LCP element and
      was optimised on lab numbers alone. This is the only thing here that says
      whether 137kB of WebP actually lands on a real phone on a real network.

      Wired by hand rather than with `@vercel/speed-insights/astro`, which does
      not work here. That component renders <vercel-speed-insights> and relies
      on its own hoisted <script> to define the element; Astro drops the script
      without a warning, so the element ships undefined and the page collects
      nothing while the HTML looks right. Verified by grepping the build: the
      equivalent `customElements.define` for analytics is in the bundle and the
      speed-insights one is in no chunk at all.

      The likely cause, held loosely because it was not worth proving: both
      packages ship the component as dist/astro/index.astro, which keys their
      scripts `index.astro_astro_type_script_index_0` -- the same key as
      src/pages/index.astro's own script. Analytics survives that collision and
      speed-insights does not. Importing the module directly sidesteps the
      question, and is what the rest of this repo does anyway.
    */}
    <script>
      import { injectSpeedInsights } from '@vercel/speed-insights';
      // Astro.routePattern rather than the pathname. Every page here is its own
      // file, so today the two are identical -- it matters the day a study
      // becomes /work/[slug], which would otherwise report one row per study
      // and lose the aggregate. Read off the DOM for the same reason
      // analytics.ts does: a hoisted script cannot see frontmatter, and
      // define:vars would force it inline instead of letting it bundle.
      const route = document.body.dataset.route;
      injectSpeedInsights({ route, framework: 'astro' });
    </script>
    <style is:global>
      .skip {
        position: absolute; left: -9999px;
        background: var(--semantic-bg-canvas); color: var(--semantic-fg-primary);
        padding: 12px 20px; border-radius: var(--primitive-radius-r8);
      }
      .skip:focus { left: 16px; top: 16px; z-index: 10; }
    </style>
  </body>
</html>
