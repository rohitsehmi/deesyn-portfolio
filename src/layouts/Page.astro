---
import Base from './Base.astro';
import { Nav } from '../components/Nav';
import { Band } from '../components/Band';
import { Footer } from '../components/Footer';
import { linksFor } from '../data/nav';
import { readingTime } from '../data/reading-time';

/**
 * The shell for standard content pages: about, cv, contact.
 *
 * Simpler than CaseStudy.astro on purpose. A case study has a fixed section
 * order because the questions it answers come in one; these pages do not, so
 * they take a single slot.
 */
interface Props {
  title: string;
  standfirst?: string;
  description?: string;
  /**
   * `<file>:<path>` into src/copy for the heading and the standfirst, which
   * makes them editable in the browser under `npm run dev`. Dev tooling only;
   * they render as plain data attributes and do nothing in a build.
   */
  titleCopyRef?: string;
  standfirstCopyRef?: string;
  /**
   * The copy file to measure a reading time from, named rather than derived
   * from the URL.
   *
   * Opt-in because most pages here should not carry one. /contact is eighteen
   * words and would render "1 min read" over a single button, which reads as a
   * system applying itself where nobody asked; /about and /cv have no copy file
   * at all and would silently get nothing. Naming the file makes both cases a
   * decision instead of an accident.
   */
  readingTimeFor?: string;
}
const { title, standfirst, description, titleCopyRef, standfirstCopyRef, readingTimeFor } =
  Astro.props;
const links = linksFor(Astro.url.pathname);

const reading = readingTimeFor ? readingTime(readingTimeFor) : null;

/*
  The footer continues the alternation rather than assuming one. With a body
  band the page ends sunken, so the footer is `base`; without one the hero is
  the last thing above it and the footer has to step to `sunken` instead, or
  banding rule 1 fires — two consecutive bands sharing a fill. The index page
  already ends `base -> sunken/compact` for the same reason; this makes the
  rule hold rather than leaving it to whoever writes the next page.
*/
const hasBody = Astro.slots.has('default');
const footerRole = hasBody ? 'base' : 'sunken';
---

<Base title={`${title} · Rohit Sehmi`} description={description ?? standfirst} pageEnd={footerRole}>
  <Nav client:load sticky links={links} />

  <main id="main">
    <Band role="base" scale="feature">
      <h1 class="page-hero__title" data-copy={titleCopyRef}>{title}</h1>
      {standfirst && <p class="page-hero__standfirst" data-copy={standfirstCopyRef}>{standfirst}</p>}
      {/*
        Same treatment as a case study's: computed from the copy, carrying no
        data-copy so the browser editor cannot write a stale number back into
        the JSON, and a <time> because a duration is what datetime takes.
      */}
      {reading && (
        <p class="page-hero__meta">
          <time datetime={`PT${reading.minutes}M`}>{reading.label}</time>
        </p>
      )}
      {/*
        Optional, and only rendered when something fills it — an empty wrapper
        would still add its own top margin and open a gap under the standfirst
        on every page that does not use it.

        For the one action a page is for, sat directly under the sentence that
        explains why you would want it. Anything further down is a second
        chance, not the first one.
      */}
      {Astro.slots.has('actions') && (
        <div class="page-hero__actions"><slot name="actions" /></div>
      )}
    </Band>

    {/*
      Conditional for the same reason `actions` is: a band with nothing in it
      still paints its fill and its padding, so a page that says everything in
      its hero would render an empty grey strip under it. /contact is that page.
    */}
    {hasBody && (
      <Band role="sunken" scale="default">
        <slot />
      </Band>
    )}
  </main>

  <Band role={footerRole} scale="compact" bleed>
    <Footer scale="compact" currentPath={Astro.url.pathname} />
  </Band>
</Base>

<style is:global>
  /*
    One step below a case study's hero, all the way down: heading-l -> display-s
    on the title where a study runs display-s -> display-m, and body-1 -> body-l
    on the standfirst where a study runs body-l -> body-xl.

    The distinction is what the words are doing. A case study's title is a
    sentence carrying the argument and it earns a display size. "CV" and "About"
    are labels on furniture — at display-m, a two-letter word was set at 52px,
    and the CV hero took 503px of an 844px phone screen before a single line of
    the CV appeared. The step down gives that back without inventing a size:
    every value here is still a style on the scale, and nothing clamps.
  */
  .page-hero__title {
    margin: 0 0 var(--primitive-space-sp600);
    max-width: 18ch;
    font: var(--type-heading-l);
    letter-spacing: var(--type-heading-l-tracking);
    color: var(--semantic-fg-primary);
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .page-hero__title { font: var(--type-display-s); letter-spacing: var(--type-display-s-tracking); }
  }

  .page-hero__standfirst {
    margin: 0;
    max-width: 60ch;
    font: var(--type-body-1);
    letter-spacing: var(--type-body-1-tracking);
    color: var(--semantic-fg-secondary);
    text-wrap: pretty;
  }
  @media (min-width: 768px) {
    .page-hero__standfirst { font: var(--type-body-l); letter-spacing: var(--type-body-l-tracking); }
  }

  /*
    Matches .cs-hero__meta: 16px under the standfirst, body weight rather than
    emphasis. The two are stated separately rather than shared, the same way
    the two heroes already state their own title and standfirst — these layouts
    have never had a common stylesheet, and inventing one for five declarations
    would put the case study's rhythm and this page's on the same hook.
  */
  .page-hero__meta {
    margin: var(--primitive-space-sp500) 0 0;
    font: var(--type-body-2);
    letter-spacing: var(--type-body-2-tracking);
    color: var(--semantic-fg-secondary);
  }

  /* Wraps rather than shrinks: on a narrow screen the note drops below the
     button instead of squeezing it under its own label. */
  .page-hero__actions {
    margin-top: var(--primitive-layout-l40);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--primitive-space-sp500);
  }
</style>
