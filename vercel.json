{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "rewrites": [
    {
      "source": "/og.png",
      "destination": "/og-deesyn.png"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "^deesyn\\.com$" }],
      "destination": "https://www.deesyn.com/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "^(?:www\\.)?deesyn\\.com$|^.+\\.vercel\\.app$"
        }
      ],
      "destination": "https://www.deesyn.com/$1",
      "permanent": false
    },
    {
      "source": "/work/search-experience",
      "destination": "/work/making-the-app-testable",
      "permanent": false
    },
    {
      "source": "/work/search-experience/",
      "destination": "/work/making-the-app-testable",
      "permanent": false
    },
    {
      "source": "/Rohit-Sehmi-CV-2026.pdf",
      "destination": "/Ro_CV.pdf",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^.+\\.vercel\\.app$"
        }
      ],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/Ro_CV.pdf",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}