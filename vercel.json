{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    {
      "source": "/:path*",
      "missing": [
        {
          "type": "host",
          "value": "^(?:(?:www|wise|revolut|healf)\\.)?deesyn\\.com$|^.+\\.vercel\\.app$"
        }
      ],
      "destination": "https://www.deesyn.com/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}