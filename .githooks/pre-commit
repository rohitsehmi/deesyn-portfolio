#!/bin/sh
#
# Regenerate the specs whenever the things they are generated from change.
#
# `components/specs/*` are measured from component source and stylesheets. Edit
# a prop or a token and the spec is stale the moment you commit -- and a stale
# generated file is invisible in review, because the diff you are reading is the
# one that did not get made. CI catches it, but only after a push, and a red
# build you have to come back to is a worse tool than one that never goes red.
#
# Only runs when something it reads has actually changed, so an ordinary copy or
# docs commit pays nothing.

# `paths` is in here because design/paths.mjs decides which directories the
# specs are measured from and written to. A change there can stale every spec
# without touching a single component, which is the exact failure this hook
# exists to catch. `build` already covers build-code-specs.mjs by prefix.
changed=$(git diff --cached --name-only --diff-filter=ACM)
echo "$changed" | grep -qE '^src/components/.*\.(tsx|css)$|^design/(build|usage-rules|paths)' || exit 0

command -v node >/dev/null 2>&1 || exit 0
[ -d node_modules ] || exit 0

# The twelve components measured from Figma regenerate NOTHING when their code
# changes, so everything below this is silent for exactly the case where the two
# sides can drift. That is not hypothetical: this hook ran on the commit that
# added a second footer link, found no stale spec, and said nothing, while
# Chrome/Footer in Figma was left describing one. Printed before `npm run specs`
# rather than after, because that step exits early on failure and would swallow
# the notice. It only ever prints -- nothing here is auto-fixable, since the
# other half of the change is in a file this machine cannot reach.
components=$(echo "$changed" | grep -E '^src/components/.*\.(tsx|css)$')
[ -n "$components" ] && node design/component-specs.mjs $components

npm run specs >/dev/null 2>&1 || {
  echo "pre-commit: npm run specs failed — commit anyway and fix, or run it by hand." >&2
  exit 0
}

stale=$(git diff --name-only -- components/specs icons/specs marks/specs public)
[ -z "$stale" ] && exit 0

git add components/specs icons/specs marks/specs public
echo "pre-commit: regenerated and staged —"
echo "$stale" | sed 's/^/  /'
