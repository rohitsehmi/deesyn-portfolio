# Chromatic. Copy to .env and fill in — .env is gitignored.
#
# This is a WRITE credential: it can publish builds to the project and consume
# snapshot quota. Never commit it, never pass it on the command line (it lands
# in shell history). In CI it belongs in a GitHub Actions secret of the same name.
#
# Rotate it in Chromatic → Manage → Configure if it is ever pasted somewhere
# shared.
CHROMATIC_PROJECT_TOKEN=
