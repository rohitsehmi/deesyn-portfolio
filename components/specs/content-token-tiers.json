        "local": "--tt-selected-edge"
      }
    ],
    ".token-tiers__brand:has(.token-tiers__radio:checked)": [
      {
        "property": "background",
        "var": "--tt-accent-shifted",
        "local": "--tt-accent-shifted"
      },
      {
        "property": "outline",
        "var": "--tt-accent-edge",
        "local": "--tt-accent-edge"
      }
    ],
    ".token-tiers__brand:has(.token-tiers__radio:focus-visible)": [
      {
        "property": "outline",
        "var": "--semantic-border-focus",
        "ref": "semantic.*.border.focus"
      }
    ]
  }
}
