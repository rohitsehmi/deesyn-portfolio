        "width": 152,
        "height": 24
      },
      "tokens": {
        ".": {
          "gap": {
            "token": "Space/sp200",
            "ref": "primitive.space.sp200",
            "type": "dimension",
            "value": "6px"
          }
        },
        "label": {
          "textStyle": {
            "token": "Body/1",
            "ref": "typography.body.1",
            "fontFamily": "Inter",
            "fontWeight": 400,
            "fontSize": "16px",
            "lineHeight": 1.5,
            "letterSpacing": "-0.01em"
          },
          "textDecoration": "UNDERLINE",
          "fg": {
