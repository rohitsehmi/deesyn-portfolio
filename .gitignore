# macOS
.DS_Store

# Node
node_modules/
npm-debug.log*

# Agent memory — a symlink to ~/.claude/projects/…, machine-specific and
# outside the repo. Committing it would store a broken absolute-path link.
memory

# Local Claude Code settings (machine-specific permissions)
.claude/settings.local.json

# Vercel CLI link. Deploys run off the GitHub integration, so this directory
# does not exist here today -- it appears the first time anyone runs a `vercel`
# command in this folder, and it carries project and org ids. This repo is
# public, so it is ignored before it can exist rather than after.
.vercel/

# Build output
dist/
storybook-static/
.astro/

# Secrets — Chromatic project token lives here, never in the repo
.env
.env.local

# Chromatic run artefacts
chromatic.log
chromatic-diagnostics.json
build-storybook.log

# Copy drafts. Exported from src/copy for a bulk rewrite and imported back;
# the JSON is the source of truth and two of them would be one too many.
copy-drafts/
